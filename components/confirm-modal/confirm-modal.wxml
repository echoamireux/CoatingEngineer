<view class="modal-mask" wx:if="{{show}}" bindtap="onMaskTap">
    <view class="modal-card" catchtap="preventBubble">
        <view class="modal-title">{{title}}</view>
        <view class="modal-content" wx:if="{{content}}">{{content}}</view>
        <slot></slot>
        <view class="modal-footer">
            <button class="btn-cancel" bindtap="onCancel">{{cancelText}}</button>
            <button class="btn-confirm {{confirmDanger ? 'danger' : ''}}" bindtap="onConfirm">{{confirmText}}</button>
        </view>
    </view>
</view>