/* components/coating-window-chart/index.wxss */
.chart-container {
  background: var(--card); /* 适配暗色模式 */
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  border: 1px solid var(--border);
}

/* ... headers ... */

.canvas-box {
  width: 100%;
  height: 480rpx;
  position: relative;
  background: var(--bg); /* 改为页面背景色，避免过亮 */
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid var(--border);
}

/* ... */

.mode-switch {
  display: flex;
  background: var(--bg); /* 深色背景 */
  padding: 8rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  border: 1px solid var(--border);
}

.switch-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 12rpx 0;
  border-radius: 12rpx;
  color: var(--text-sub);
  transition: all 0.3s;
}

.switch-item.active {
  background: var(--accent-dim); /* 激活状态深色 */
  color: var(--primary);
  font-weight: 600;
  box-shadow: none;
  border: 1px solid var(--primary);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.title-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text, #f3f4f6);
}

.chart-subtitle {
  font-size: 20rpx;
  color: var(--text-sub, #9ca3af);
  font-weight: 400;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.05);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-sub, #9ca3af);
  transition: all 0.3s ease;
}

/* ... lines 46-59 unchanged ... */

.advanced-controls {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: rgba(255,255,255,0.02);
  padding: 20rpx;
  border-radius: 12rpx;
}

.mini-input {
  width: 120rpx;
  height: 50rpx;
  background: rgba(255,255,255,0.05); /* Transparent Input Bg */
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
}

.status-badge.stable {
  background: rgba(16, 185, 129, 0.1);
  color: #34d399;
}

.status-badge.warning {
  background: rgba(245, 158, 11, 0.1);
  color: #fbbf24;
}

.status-badge.danger {
  background: rgba(239, 68, 68, 0.1);
  color: #f87171;
}

.canvas-box {
  width: 100%;
  height: 480rpx;
  position: relative;
  background: #111827; /* Force Dark Background for Canvas */
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.1);
}

.coating-canvas {
  width: 100%;
  height: 100%;
}

.mode-switch {
  display: flex;
  background: rgba(255,255,255,0.05);
  padding: 8rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.switch-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 12rpx 0;
  border-radius: 12rpx;
  color: var(--text-sub, #9ca3af);
  transition: all 0.3s;
}

.switch-item.active {
  background: rgba(99, 102, 241, 0.2); /* Accent Dim */
  color: #818cf8; /* Accent Color */
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.coordinates {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.coord-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.coord-label {
  font-size: 22rpx;
  color: var(--text-sub, #9ca3af);
}

.coord-value {
  font-size: 32rpx;
  font-weight: bold;
  font-family: 'Courier New', Courier, monospace;
  color: #818cf8;
}

.controls {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.control-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.control-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 10rpx;
}

.control-label {
  font-size: 26rpx;
  color: var(--text, #e5e7eb);
}

.control-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #818cf8;
}

slider {
  margin: 0;
}

.advanced-toggle {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub, #9ca3af);
  padding: 10rpx 0;
  cursor: pointer;
}

.advanced-controls {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: rgba(255,255,255,0.02);
  padding: 20rpx;
  border-radius: 12rpx;
}

.mini-input {
  width: 120rpx;
  height: 50rpx;
  background: rgba(255,255,255,0.05); /* Transparent Input Bg */
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
}
