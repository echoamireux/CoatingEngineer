.card-container {
  background-color: var(--card, #ffffff);
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 20rpx 0;
  border-left: 8rpx solid var(--primary, #007aff);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  border-bottom: 1px solid var(--border, rgba(0, 0, 0, 0.1));
  padding-bottom: 12rpx;
}

.card-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text, #333);
  letter-spacing: 1rpx;
}

.card-body {
  display: grid;
  grid-template-columns: repeat(1, 1fr); /* Mobile layout: 1 column */
  gap: 16rpx;
}

.card-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.item-label {
  font-size: 26rpx;
  color: var(--text-sub, #666);
}

.item-value {
  font-size: 26rpx;
  color: var(--text, #333);
  font-weight: 500;
  text-align: right;
  max-width: 60%;
}
