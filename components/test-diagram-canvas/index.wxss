.diagram-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx 0;
  padding: 16rpx;
  background-color: var(--bg-color-card);
  border-radius: 16rpx;
}

.canvas {
  width: 100%;
  height: 240px; /* Standard height for diagrams */
  background-color: transparent;
}

.caption {
  font-size: 24rpx;
  color: var(--text-color-secondary);
  margin-top: 12rpx;
  text-align: center;
}
