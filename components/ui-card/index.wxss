/* components/ui-card/index.wxss */
.ui-card {
  background: var(--card-bg, #1f2937);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1px solid var(--border, #374151);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  position: relative;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary, #10b981);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
