/* ============================================================
   涂布工程专家 - 全局主题系统
   统一管理所有页面的主题变量，确保一致性
   ============================================================ */

/* ============================================================
   默认主题（暗黑模式）
   所有页面共享的核心变量
   ============================================================ */
page {
  /* === 核心颜色 === */
  --bg: #111827;           /* 主背景色 */
  --card: #1f2937;         /* 卡片背景色 */
  --text: #e5e7eb;         /* 主文本色 */
  --text-sub: #9ca3af;     /* 次要文本色 */
  --border: #374151;       /* 边框色 */
  --primary: #10b981;      /* 主题色（翠绿）*/

  /* === 阴影系统 === */
  --title-shadow: 0 4rpx 8rpx rgba(0,0,0,0.5);        /* 标题阴影 */
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.5);     /* 弹窗阴影 */
  --card-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);       /* 卡片阴影 */

  /* === 输入框 === */
  --input-bg: rgba(255,255,255,0.05);                /* 输入框背景 */
  --input-placeholder: rgba(255,255,255,0.3);       /* 占位符颜色 */

  /* === 语义颜色 === */
  --success: #10b981;        /* 成功 */
  --warning: #f59e0b;        /* 警告 */
  --error: #ef4444;          /* 错误 */
  --info: #3b82f6;           /* 信息 */

  /* === 关于弹窗专用 === */
  --about-title: #ffffff;    /* 弹窗标题 */
  --about-tag: #e5e7eb;      /* 弹窗标签 */
  --about-text: #9ca3af;     /* 弹窗正文 */
  --reward-bg: #2d2a26;      /* 赞赏按钮背景 */
  --reward-border: #d4af37;  /* 赏识按钮边框 */
  --reward-text: #d4af37;    /* 赏识按钮文字 */

  /* === 悬浮胶囊 === */
  --capsule-bg: rgba(31, 41, 55, 0.95);
  --capsule-shadow: 0 8rpx 32rpx rgba(0,0,0,0.5);

  /* === 特殊卡片 === */
  --card-res: #2d3748;       /* 结果卡片背景 */
}

/* ============================================================
   明亮模式
   ============================================================ */
page.light {
  /* === 核心颜色 === */
  --bg: #f3f4f6;
  --card: #ffffff;
  --text: #1f2937;
  --text-sub: #6b7280;
  --border: rgba(0,0,0,0.05);
  --primary: #059669;

  /* === 阴影系统 === */
  --title-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.1);
  --card-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);

  /* === 输入框 === */
  --input-bg: rgba(0,0,0,0.03);
  --input-placeholder: rgba(0,0,0,0.25);

  /* === 语义颜色 === */
  --success: #059669;
  --warning: #d97706;
  --error: #ef4444;
  --info: #3b82f6;

  /* === 关于弹窗专用 === */
  --about-title: #111827;
  --about-tag: #374151;
  --about-text: #6b7280;
  --reward-bg: #fffbeb;
  --reward-border: #b45309;
  --reward-text: #b45309;

  /* === 悬浮胶囊 === */
  --capsule-bg: rgba(255, 255, 255, 0.95);
  --capsule-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);

  /* === 特殊卡片 === */
  --card-res: #f9fafb;
}

/* ============================================================
   涂布计算页 - 工业精密风
   蓝色系主题
   ============================================================ */
page.theme-coating {
  --bg: #0f172a;           /* 深蓝黑 */
  --card: #1e293b;
  --text: #f1f5f9;
  --text-sub: #94a3b8;
  --border: #334155;
  --input-bg: #020617;
  --primary: #38bdf8;      /* 亮蓝色 */
  --accent: #38bdf8;       /* 强调色 */
  --accent-dim: rgba(56, 189, 248, 0.1);
  --input-placeholder: rgba(255, 255, 255, 0.1);
}

page.light.theme-coating {
  --bg: #f1f5f9;
  --card: #ffffff;
  --text: #0f172a;
  --text-sub: #64748b;
  --border: #e2e8f0;
  --input-bg: #f8fafc;
  --primary: #0284c7;
  --accent: #0284c7;
  --accent-dim: rgba(2, 132, 199, 0.1);
  --input-placeholder: rgba(0, 0, 0, 0.1);
}

/* ============================================================
   流体力学页 - 午夜蓝主题
   ============================================================ */
page.theme-fluid {
  --bg: #10141e;           /* 午夜蓝黑 */
  --card: #1f2937;
  --text: #f3f4f6;
  --text-sub: #9ca3af;
  --border: #374151;
  --input-bg: #111827;
  --primary: #3b82f6;      /* 亮蓝色 */
  --accent: #3b82f6;
  --highlight: #38bdf8;    /* 高亮蓝 */
  --btn-sub: #374151;
}

page.light.theme-fluid {
  --bg: #f2f4f7;
  --card: #ffffff;
  --text: #333;
  --text-sub: #666;
  --border: #e0e0e0;
  --input-bg: #f7f8fa;
  --primary: #1989fa;
  --accent: #1989fa;
  --highlight: #1989fa;
  --btn-sub: #999;
}

/* ============================================================
   成本核算页 - 纯黑主题
   ============================================================ */
page.theme-cost {
  --bg: #000000;           /* 纯黑 */
  --card: #1f2937;
  --text: #e5e7eb;
  --text-sub: #9ca3af;
  --border: #374151;
  --primary: #10b981;      /* 翠绿色 */
  --warn: #f59e0b;
  --card-res: #2d3748;
  --input-bg: rgba(255,255,255,0.08);
  --capsule-bg: rgba(31, 41, 55, 0.95);
  --capsule-shadow: 0 8rpx 32rpx rgba(0,0,0,0.5);
}

page.light.theme-cost {
  --bg: #f3f4f6;
  --card: #ffffff;
  --text: #1f2937;
  --text-sub: #6b7280;
  --border: #e5e7eb;
  --primary: #059669;
  --warn: #d97706;
  --card-res: #f9fafb;
  --input-bg: rgba(0,0,0,0.05);
  --capsule-bg: rgba(255, 255, 255, 0.95);
  --capsule-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

/* ============================================================
   单位换算页 - 紫色主题
   ============================================================ */
page.theme-converter {
  --primary: #8b5cf6;      /* 紫罗兰色 */
}

page.light.theme-converter {
  --primary: #7c3aed;
}

/* ============================================================
   历史记录页 - 绿色主题
   ============================================================ */
page.theme-history {
  --primary: #10b981;      /* 翠绿色 */
  --tag-fluid: #3b82f6;    /* 流体力学标签 */
  --tag-conv: #8b5cf6;    /* 单位换算标签 */
  --tag-coat: #6366f1;    /* 涂布计算标签 */
}

page.light.theme-history {
  --primary: #059669;
  --tag-fluid: #3b82f6;
  --tag-conv: #8b5cf6;
  --tag-coat: #6366f1;
}

/* ============================================================
   单位换算页特有变量
   ============================================================ */
page.theme-converter {
  --primary: #8b5cf6;      /* 紫罗兰色 */
  --nav-bg: #161e2a;       /* 侧栏背景 */
  --nav-active: rgba(59,130,246,0.15);
  --input: #111827;        /* 输入框背景 */
}

page.light.theme-converter {
  --primary: #7c3aed;
  --nav-bg: #eef2f6;
  --nav-active: #ffffff;
  --input: #f7f8fa;
}

/* ============================================================
   流体力学页特有变量
   ============================================================ */
page.theme-fluid {
  --input: #111827;        /* 输入框背景 */
  --btn-sub: #374151;      /* 次要按钮背景 */
}

page.light.theme-fluid {
  --input: #f7f8fa;
  --btn-sub: #999;
}
