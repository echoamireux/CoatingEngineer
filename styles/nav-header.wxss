/*
 * 双排导航栏公共样式
 * 设计规范：
 * - 第一行：返回按钮 + 标题（左对齐）
 * - 第二行：功能工具栏
 */

/* 页面头部容器 */
.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  box-sizing: border-box;
}

/* 第一行：导航层 */
.nav-row {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 16rpx;
  box-sizing: border-box;
}

/* 返回按钮 */
.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border-radius: 50%;
  border: 1px solid var(--border);
  font-size: 32rpx;
  color: var(--text);
  flex-shrink: 0;
}

/* 页面标题 - 左对齐 */
.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1; /* 占据剩余空间 */
}

/* 第二行：工具栏层 */
.toolbar-row {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 32rpx;
  border-top: 1px solid var(--border);
  background: var(--card);
  box-sizing: border-box;
}

/* 工具按钮 */
.tool-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.tool-btn:active {
  background: var(--border);
  transform: scale(0.95);
}

.tool-btn .icon {
  font-size: 32rpx;
}

.tool-btn .label {
  font-size: 24rpx;
}

/* 工具栏分隔线 */
.toolbar-divider {
  width: 1px;
  height: 24rpx;
  background: var(--border);
}
