/* === V25 风格样式 === */
page {
  --bg: #10141e; 
  --card: #1f2937; 
  --text: #f3f4f6; 
  --text-sub: #9ca3af;
  --border: #374151; 
  --accent: #3b82f6;
  /* 不同模块的标签颜色 */
  --tag-fluid: #3b82f6; 
  --tag-conv: #8b5cf6; 
  --tag-coat: #6366f1;
}
.page-container.light {
  --bg: #f2f4f7; --card: #ffffff; --text: #333; --text-sub: #666; --border: #e0e0e0;
}

.page-container {
  min-height: 100vh; background: var(--bg); color: var(--text);
  padding: 24rpx; box-sizing: border-box; display: flex; flex-direction: column;
  font-family: -apple-system, sans-serif;
}

/* 顶部栏 */
.nav-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.nav-title { font-size: 34rpx; font-weight: 800; letter-spacing: 1px; }
.actions { display: flex; gap: 20rpx; }

/* 按钮 */
.icon-btn { 
  background: var(--card); border: 1px solid var(--border); 
  width: 64rpx; height: 64rpx; border-radius: 32rpx; 
  display: flex; align-items: center; justify-content: center; font-size: 30rpx; 
}
.icon-btn.danger { color: #ef4444; border-color: rgba(239,68,68,0.3); }

/* 列表滚动区 */
.history-list { flex: 1; overflow-y: auto; }

/* 历史卡片 */
.h-card {
  background: var(--card); border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 24rpx; border: 1px solid var(--border);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.hc-head { 
  display: flex; justify-content: space-between; align-items: center; 
  margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1px dashed var(--border); 
}

/* 标签样式 */
.hc-tag { font-size: 20rpx; color: #fff; padding: 6rpx 12rpx; border-radius: 8rpx; font-weight: bold; }
.hc-tag.fluid { background: var(--tag-fluid); }
.hc-tag.converter { background: var(--tag-conv); }
.hc-tag.coating { background: var(--tag-coat); }

.hc-time { font-size: 22rpx; color: var(--text-sub); flex: 1; text-align: right; margin-right: 20rpx; }
.hc-del { color: var(--text-sub); font-size: 40rpx; padding: 0 10rpx; line-height: 0.8; opacity: 0.6; }

/* 数据行 */
.hc-body { display: flex; flex-direction: column; gap: 10rpx; }
.hc-row { display: flex; justify-content: space-between; font-size: 26rpx; }
.hc-k { color: var(--text-sub); }
.hc-v { color: var(--text); font-weight: bold; font-family: monospace; }

/* 空状态 */
.empty-state { text-align: center; color: var(--text-sub); margin-top: 200rpx; font-size: 28rpx; opacity: 0.5; }

/* 🔥 弹窗样式补充 🔥 */
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-card { background: var(--card); width: 80%; padding: 30rpx; border-radius: 16rpx; border: 1px solid var(--border); }
.modal-card.small { width: 55%; }
.dark-theme-fix { background: var(--card) !important; color: var(--text) !important; border-color: var(--border) !important; }

.mc-head { text-align: center; font-weight: bold; color: var(--text); margin-bottom: 20rpx; font-size: 30rpx; }
.mc-foot { display: flex; gap: 20rpx; margin-top: 30rpx; }
.mc-foot button { flex: 1; font-size: 26rpx; background: var(--border); color: var(--text-sub); border: none; }
.mc-foot button.red { background: rgba(239,68,68,0.2); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }