/* === V25 风格样式 === */
page {
  --bg: #10141e;
  --card: #1f2937;
  --text: #f3f4f6;
  --text-sub: #9ca3af;
  --border: #374151;
  --accent: #3b82f6;
  /* 不同模块的标签颜色 */
  --tag-fluid: #3b82f6;
  --tag-conv: #8b5cf6;
  --tag-coat: #6366f1;
}

.page-container.light {
  --bg: #f2f4f7;
  --card: #ffffff;
  --text: #333;
  --text-sub: #666;
  --border: #e0e0e0;
}

.page-container {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, sans-serif;
}

/* 固定头部 */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--card);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}

/* 顶部栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  /* 轻微分割线 */
}

.nav-title {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1px;
}

.actions {
  display: flex;
  gap: 20rpx;
}

/* 按钮 */
.icon-btn {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border);
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.icon-btn.danger {
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.3);
}

/* 列表滚动区 */
.history-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 30rpx;
  width: 100%;
  /* Ensure full width */
  box-sizing: border-box;
  /* Prevent padding from causing overflow */
}

/* 历史卡片 */
.h-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1px solid var(--border);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.hc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px dashed var(--border);
}

/* 标签样式 */
/* 标签样式 */
.hc-tag {
  font-size: 20rpx;
  color: #fff;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.hc-tag.fluid {
  background: #3b82f6;
  /* Ocean */
}

.hc-tag.tools,
.hc-tag.converter {
  background: #8b5cf6;
  /* Violet */
}

.hc-tag.coating {
  background: #f59e0b;
  /* Amber */
}

.hc-tag.cost {
  background: #10b981;
  /* Emerald */
}

.hc-time {
  font-size: 22rpx;
  color: var(--text-sub);
  flex: 1;
  text-align: right;
  margin-right: 20rpx;
}

.hc-del {
  color: var(--text-sub);
  font-size: 40rpx;
  padding: 0 10rpx;
  line-height: 0.8;
  opacity: 0.6;
}

/* 数据行 */
.hc-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hc-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}

.hc-k {
  color: var(--text-sub);
}

.hc-v {
  color: var(--text);
  font-weight: bold;
  font-family: monospace;
}

/* 空状态 */
.empty-state {
  text-align: center;
  color: var(--text-sub);
  margin-top: 200rpx;
  font-size: 28rpx;
  opacity: 0.5;
}

/* 🔥 弹窗样式补充 🔥 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  background: var(--card);
  width: 80%;
  padding: 30rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border);
}

.modal-card.small {
  width: 55%;
}

.dark-theme-fix {
  background: var(--card) !important;
  color: var(--text) !important;
  border-color: var(--border) !important;
}

.mc-head {
  text-align: center;
  font-weight: bold;
  color: var(--text);
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.mc-foot {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.mc-foot button {
  flex: 1;
  font-size: 26rpx;
  background: var(--border);
  color: var(--text-sub);
  border: none;
}

.mc-foot button.red {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

/* 模块筛选栏 */
.filter-bar {
  white-space: nowrap;
  padding: 16rpx 30rpx 20rpx 30rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  transition: all 0.2s;
}

.filter-item.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.filter-icon {
  font-size: 24rpx;
}

/* Module Specific Active Colors */
.filter-item[data-module="cost"].active {
  background: #10b981;
  border-color: #10b981;
}

.filter-item[data-module="fluid"].active {
  background: #3b82f6;
  border-color: #3b82f6;
}

.filter-item[data-module="coating"].active {
  background: #f59e0b;
  border-color: #f59e0b;
}

.filter-item[data-module="converter"].active {
  background: #8b5cf6;
  border-color: #8b5cf6;
}

/* 回填提示 - Professional Neutral Style */
.hc-hint {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1px dashed var(--border);
  font-size: 20rpx;
  color: var(--text-sub);
  /* Grey instead of theme color */
  text-align: center;
  opacity: 0.7;
  letter-spacing: 1rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 60vh;
  /* Full viewport height minus headers */
  color: var(--text-sub);
  font-size: 28rpx;
  opacity: 0.5;
}

/* 成本模块标签 */
.hc-tag.cost {
  background: #10b981;
}