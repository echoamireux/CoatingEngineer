/* History 页面样式 - 继承全局主题变量 */
page {
  /* History专属变量：不同模块的标签颜色 */
  --tag-fluid: #3b82f6;
  --tag-conv: #8b5cf6;
  --tag-coat: #6366f1;
}

.page-container {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, sans-serif;
}

/* 固定头部 - 移除margin-bottom，沉浸式设计 */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--bg);
}

/* 导航栏样式 - 沉浸式设计 */
.page-header {
  background: var(--bg);
  box-sizing: border-box;
}

/* 导航栏 - 第一行 */
.nav-row {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}



/* 嵌入在筛选栏右侧的清除按钮 */
.clear-btn-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

/* Back Button */
.back-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

/* 列表滚动区 */
.history-list {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 30rpx; /* Add top padding */
  width: 100%;
  box-sizing: border-box;
}

/* 历史卡片内容样式 (Container is now ui-card) */
.hc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px dashed var(--border);
}

/* 标签样式 */
.hc-tag {
  font-size: 20rpx;
  color: #fff;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.hc-tag.fluid { background: #3b82f6; }
.hc-tag.tools, .hc-tag.converter { background: #8b5cf6; }
.hc-tag.coating { background: #f59e0b; }
.hc-tag.cost { background: #10b981; }

.hc-time {
  font-size: 22rpx;
  color: var(--text-sub);
  flex: 1;
  text-align: right;
  margin-right: 20rpx;
}

.hc-del {
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
}

/* 数据行 */
.hc-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hc-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}

.hc-k { color: var(--text-sub); }

.hc-v {
  color: var(--text);
  font-weight: bold;
  font-family: monospace;
}

/* 回填提示 */
.hc-hint {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1px dashed var(--border);
  font-size: 20rpx;
  color: var(--text-sub);
  text-align: center;
  opacity: 0.7;
  letter-spacing: 1rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 60vh;
  color: var(--text-sub);
  font-size: 28rpx;
  opacity: 0.5;
}

/* 模块筛选栏 */
.filter-bar {
  white-space: nowrap;
  padding: 16rpx 30rpx 20rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  transition: all 0.2s;
}

.filter-item.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.filter-icon {
  font-size: 24rpx;
}

/* Module Specific Active Colors */
.filter-item[data-module="cost"].active { background: #10b981; border-color: #10b981; }
.filter-item[data-module="fluid"].active { background: #3b82f6; border-color: #3b82f6; }
.filter-item[data-module="coating"].active { background: #f59e0b; border-color: #f59e0b; }
.filter-item[data-module="converter"].active { background: #8b5cf6; border-color: #8b5cf6; }

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}