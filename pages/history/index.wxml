<view class="page-container {{theme}} {{themeClass}}">

  <!-- 固定头部区域 -->
  <view class="sticky-header">

    <!-- 双排导航栏：专业紧凑设计 -->
    <view class="page-header" style="padding-top: {{statusBarHeight}}px;">
      <!-- Row 1: 标题栏 -->
      <view class="nav-row">
        <!-- 左侧：返回 + 标题 -->
        <view class="nav-left">
          <view class="back-btn" bindtap="goBack">←</view>
          <text class="page-title">历史记录</text>
        </view>
      </view>

    <!-- 模块筛选标签 -->
    <scroll-view scroll-x class="filter-bar" style="display: flex; align-items: center;">
      <view class="filter-item {{currentModule === item.id ? 'active' : ''}}" wx:for="{{moduleOptions}}" wx:key="id"
        bindtap="switchModule" data-module="{{item.id}}">
        <text class="filter-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>

      <!-- 清除按钮：紧跟在最后一个 Filter 后面 -->
      <view class="clear-btn-inline" bindtap="clearAll" wx:if="{{filteredList.length > 0}}" style="display: inline-flex;">
        <text class="icon">🧹</text>
      </view>
    </scroll-view>
  </view>
  </view>

  <scroll-view scroll-y class="history-list">
    <block wx:if="{{filteredList.length > 0}}">
      <view class="h-card" wx:for="{{filteredList}}" wx:key="id" bindtap="onItemTap" data-item="{{item}}">

        <view class="hc-head">
          <view class="hc-tag {{item.module}}">{{item.moduleName}}</view>
          <view class="hc-time">{{item.time}}</view>
          <view class="hc-del" catchtap="deleteItem" data-id="{{item.id}}">×</view>
        </view>

        <view class="hc-body">
          <view class="hc-row" wx:for="{{item.data}}" wx:key="k" wx:for-item="sub">
            <text class="hc-k">{{sub.k}}</text>
            <text class="hc-v">{{sub.v}}</text>
          </view>
        </view>

        <view class="hc-hint">点击可回填到{{item.moduleName}}</view>
      </view>
    </block>

    <view class="empty-state" wx:else>
      <text>暂无{{currentModule === 'all' ? '' : moduleOptions[currentModule] ? moduleOptions[currentModule].name :
        ''}}计算记录</text>
    </view>
  </scroll-view>

  <!-- 使用通用确认弹窗组件 -->
  <!-- 使用通用确认弹窗组件 -->
  <confirm-modal show="{{showResetModal}}" title="清空确认" content="确定要清空当前筛选下的所有历史记录吗？此操作无法撤销。" confirmDanger="{{true}}"
    bind:confirm="execReset" bind:cancel="cancelReset" />
  <confirm-modal show="{{showDeleteModal}}" title="删除确认" content="确定要删除这条记录吗？" confirmDanger="{{true}}"
    bind:confirm="confirmDelete" bind:cancel="cancelDelete" />
</view>