<view class="page-container {{theme}}">

  <view class="nav-bar">
    <view class="nav-title">历史记录</view>
    <view class="actions">
      <view class="icon-btn danger" bindtap="clearAll" wx:if="{{historyList.length > 0}}">🗑️</view>
    </view>
  </view>

  <scroll-view scroll-y class="history-list">

    <block wx:if="{{historyList.length > 0}}">
      <view class="h-card" wx:for="{{historyList}}" wx:key="time">

        <view class="hc-head">
          <view class="hc-tag {{item.module}}">{{item.moduleName}}</view>
          <view class="hc-time">{{item.time}}</view>
          <view class="hc-del" catchtap="deleteItem" data-index="{{index}}">×</view>
        </view>

        <view class="hc-body">
          <view class="hc-row" wx:for="{{item.data}}" wx:key="k" wx:for-item="sub">
            <text class="hc-k">{{sub.k}}</text>
            <text class="hc-v">{{sub.v}}</text>
          </view>
        </view>

      </view>
    </block>

    <view class="empty-state" wx:else>
      <text>暂无计算记录</text>
    </view>

  </scroll-view>

  <!-- 使用通用确认弹窗组件 -->
  <confirm-modal show="{{showResetModal}}" title="清空确认" content="确定要删除所有历史记录吗？" confirmText="确定删除"
    confirmDanger="{{true}}" bind:cancel="cancelReset" bind:confirm="execReset" />
</view>