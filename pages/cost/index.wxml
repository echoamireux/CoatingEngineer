<view class="page-container {{theme}} theme-cost">
   <!-- 双排导航栏 -->
   <!-- 单排导航栏：紧凑设计 -->
   <!-- Fluid Style Header (Cloned) -->
   <view class="page-header" style="padding-top: {{statusBarHeight}}px;">
      <!-- Row 1: Nav -->
      <view class="nav-row">
         <view class="back-btn" bindtap="goBack">
            <ui-icon name="back" size="50" />
         </view>
         <text class="page-title">成本工序流</text>
      </view>

      <!-- Row 2: Toolbar (Icons Only) -->
      <view class="toolbar-row">
         <view class="tool-btn" bindtap="openHistoryModal" hover-class="tool-hover">
            <ui-icon name="history" />
         </view>
         <view class="tool-btn" bindtap="saveCostHistory" wx:if="{{res_final_cost !== '-'}}" hover-class="tool-hover">
            <ui-icon name="save" color="var(--primary)" />
         </view>
         <view class="tool-btn" bindtap="openClearModal" hover-class="tool-hover">
            <ui-icon name="trash" />
         </view>
      </view>
   </view>

   <scroll-view scroll-y class="main-scroll">
      <view class="card global-card compact">
         <view class="gc-header">
            <view class="gc-row" style="flex:1">
               <view class="gc-item">
                  <text class="label">计价模式</text>
                  <view class="toggle-box small">
                     <view class="{{taxMode==='ex'?'active':''}}" bindtap="setTaxMode" data-mode="ex">未税</view>
                     <view class="{{taxMode==='inc'?'active':''}}" bindtap="setTaxMode" data-mode="inc">含税</view>
                  </view>
               </view>
               <view class="gc-item">
                  <text class="label">增值税</text>
                  <view class="input-wrap mini {{focus.vatRate ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{vatRate}}" bindinput="onInput"
                        bindfocus="onInputFocus" bindblur="onInputBlur"
                        data-field="vatRate" data-type="global" placeholder="0" />
                     <text class="unit-suffix">%</text>
                  </view>
               </view>
            </view>
         </view>

         <view class="formula-hub">
            <text class="fh-title">🧮 计算原理中心：</text>
            <view class="fh-list">
               <view class="fh-tag" bindtap="showFormula" data-type="global">税率</view>
               <view class="fh-tag" bindtap="showFormula" data-type="film">膜材</view>
               <view class="fh-tag" bindtap="showFormula" data-type="glue">胶层</view>
               <view class="fh-tag" bindtap="showFormula" data-type="process">工艺</view>
               <view class="fh-tag" bindtap="showFormula" data-type="accum">累计</view>
            </view>
         </view>
      </view>

      <block wx:for="{{stages}}" wx:for-item="stage" wx:for-index="sIdx" wx:key="sIdx">
         <view class="stage-container">

            <view class="stage-header">
               <view class="sh-left" catchtap="preventBubble">
                  <view class="sh-badge">{{sIdx + 1}}</view>
                  <input class="sh-name" value="{{stage.name}}" placeholder="输入工序名称" bindinput="onInput"
                     data-type="stage_name" data-stage="{{sIdx}}" />
               </view>

               <view class="sh-right">
                  <view class="fold-summary" wx:if="{{stage.folded}}" bindtap="toggleStageFold" data-index="{{sIdx}}">
                     <text class="fs-cost">¥ {{stage.accumCost || '-'}}</text>
                     <view class="fs-yield">良率 {{stage.yield || '-'}}%</view>
                  </view>

                  <view class="sh-inputs" wx:else catchtap="preventBubble">
                     <text class="yield-label">良率</text>
                     <view class="input-wrap mini {{focus['s'+sIdx+'_yield'] ? 'focused' : ''}} {{errors['s'+sIdx+'_yield'] ? 'error' : ''}}">
                        <input class="inp-inner" type="digit" value="{{stage.yield}}"
                           bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                           data-type="stage_yield" data-stage="{{sIdx}}" data-field="yield" placeholder="0" />
                        <text class="unit-suffix">%</text>
                     </view>
                  </view>

                  <view class="fold-btn" bindtap="toggleStageFold" data-index="{{sIdx}}">
                     <ui-icon name="{{stage.folded ? 'arrow-down' : 'arrow-up'}}" size="32" color="var(--text-sub)" />
                  </view>

                  <view class="stage-del-btn" catchtap="removeStage" data-index="{{sIdx}}"
                     wx:if="{{sIdx>0 && !stage.folded}}"><ui-icon name="trash" size="32" color="#ef4444" /></view>
               </view>
            </view>

            <view wx:if="{{!stage.folded}}">
               <view class="sub-section">
                  <view class="ss-head" bindtap="toggleSectionFold" data-stage="{{sIdx}}" data-section="mat">
                     <view class="ss-head-left">
                        <text class="ss-title">📦 材料成本计算</text>
                     </view>
                     <view class="ss-head-right">
                        <text class="ss-mini-cost" wx:if="{{stage.matFolded}}">¥ {{stage.stageMatCost || 0}}</text>
                        <view class="fold-icon small"><ui-icon name="{{stage.matFolded ? 'arrow-down' : 'arrow-up'}}" size="32" color="var(--text-sub)" /></view>
                     </view>
                  </view>

                  <block wx:if="{{!stage.matFolded}}">
                     <block wx:for="{{stage.materials}}" wx:key="index">
                        <view class="mat-item">
                           <view class="mat-head">
                              <view class="input-suffix-wrapper">
                                 <input class="mat-name" value="{{item.name}}" placeholder="材料名" bindinput="onInput"
                                    data-type="material" data-stage="{{sIdx}}" data-index="{{index}}" data-field="name" />
                                 <view wx:if="{{item.type==='glue'}}" class="suffix-btn" bindtap="openMixCal"
                                    data-stage="{{sIdx}}" data-index="{{index}}">
                                    <ui-icon name="flask" size="32" color="var(--primary)" />
                                 </view>
                              </view>

                              <view class="mat-acts">
                                 <view class="arrow-btn" catchtap="moveMaterial" data-stage="{{sIdx}}"
                                    data-index="{{index}}" data-dir="{{-1}}" wx:if="{{index>0}}"><ui-icon name="line-arrow-up" size="32" color="var(--text-sub)" /></view>
                                 <view class="arrow-btn" catchtap="moveMaterial" data-stage="{{sIdx}}"
                                    data-index="{{index}}" data-dir="{{1}}" wx:if="{{index<stage.materials.length-1}}">
                                    <ui-icon name="line-arrow-down" size="32" color="var(--text-sub)" /></view>
                                 <view class="btn-del" bindtap="removeMaterial" data-stage="{{sIdx}}"
                                    data-index="{{index}}"><ui-icon name="trash" size="36" color="#ef4444" /></view>
                              </view>
                           </view>

                           <block wx:if="{{item.type==='glue'}}">
                              <view class="row-Grid three-col">
                                 <view class="field">
                                    <view class="label">单价 P<text class="sub">wet</text></view>
                                    <view class="input-wrap {{focus['s'+sIdx+'_m'+index+'_price'] ? 'focused' : ''}} {{errors['s'+sIdx+'_m'+index+'_price'] ? 'error' : ''}}">
                                       <input class="inp-inner" type="digit" value="{{item.price}}"
                                          bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                          data-type="material" data-stage="{{sIdx}}" data-index="{{index}}"
                                          data-field="price" placeholder="0" />
                                       <text class="unit-suffix">元/kg</text>
                                    </view>
                                 </view>
                                 <view class="field">
                                    <view class="label">固含 S</view>
                                    <view class="input-wrap {{focus['s'+sIdx+'_m'+index+'_solid'] ? 'focused' : ''}} {{errors['s'+sIdx+'_m'+index+'_solid'] ? 'error' : ''}}">
                                       <input class="inp-inner" type="digit" value="{{item.solid}}"
                                          bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                          data-type="material" data-stage="{{sIdx}}" data-index="{{index}}"
                                          data-field="solid" placeholder="0" />
                                       <text class="unit-suffix">%</text>
                                    </view>
                                 </view>
                                 <view class="field">
                                    <view class="label">利用率 η</view>
                                    <view class="input-wrap {{focus['s'+sIdx+'_m'+index+'_eff'] ? 'focused' : ''}} {{errors['s'+sIdx+'_m'+index+'_eff'] ? 'error' : ''}}">
                                       <input class="inp-inner" type="digit" value="{{item.eff}}"
                                          bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                          data-type="material" data-stage="{{sIdx}}" data-index="{{index}}"
                                          data-field="eff" placeholder="0" />
                                       <text class="unit-suffix">%</text>
                                    </view>
                                 </view>
                              </view>
                              <view class="row-Grid">
                                 <view class="field compact-row">
                                    <text class="label">干涂量 GSM</text>
                                    <view class="input-wrap {{focus['s'+sIdx+'_m'+index+'_gsm'] ? 'focused' : ''}} {{errors['s'+sIdx+'_m'+index+'_gsm'] ? 'error' : ''}}">
                                       <input class="inp-inner" type="digit" value="{{item.gsm}}"
                                          bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                          data-type="material" data-stage="{{sIdx}}" data-index="{{index}}"
                                          data-field="gsm" placeholder="0" />
                                       <text class="unit-suffix">g/m²</text>
                                    </view>
                                 </view>
                              </view>
                              <view class="res-card-block mat" bindtap="calcMaterialItem" data-stage="{{sIdx}}"
                                 data-index="{{index}}">
                                 <view class="rc-left">
                                    <text class="rc-title">胶层单位成本 C<text class="sub">glue</text></text>
                                    <text
                                       style="font-size:20rpx; color:#9ca3af; margin-left:10rpx; white-space:nowrap;">(纯胶层)</text>
                                 </view>
                                 <view class="rc-right">
                                    <text class="rc-val">¥ {{ (item.cost !== undefined && item.cost !== null) ?
                                       item.cost : '-' }}<text class="unit">/m²</text></text>
                                    <view class="rc-refresh"><ui-icon name="refresh" size="32" color="var(--text-sub)" /></view>
                                 </view>
                              </view>
                           </block>

                           <block wx:else>
                              <view class="row-Grid three-col">
                                 <view class="field">
                                    <view class="label">单价 P<text class="sub">area</text></view>
                                    <view class="input-wrap {{focus['s'+sIdx+'_m'+index+'_price'] ? 'focused' : ''}} {{errors['s'+sIdx+'_m'+index+'_price'] ? 'error' : ''}}">
                                       <input class="inp-inner" type="digit" value="{{item.price}}"
                                          bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                          data-type="material" data-stage="{{sIdx}}" data-index="{{index}}"
                                          data-field="price" placeholder="0" />
                                       <text class="unit-suffix">元/m²</text>
                                    </view>
                                 </view>
                                 <view class="field">
                                    <view class="label">膜宽 W<text class="sub">film</text></view>
                                    <view class="input-wrap {{focus['s'+sIdx+'_m'+index+'_widthRaw'] ? 'focused' : ''}} {{errors['s'+sIdx+'_m'+index+'_widthRaw'] ? 'error' : ''}}">
                                       <input class="inp-inner" type="digit" value="{{item.widthRaw}}"
                                          bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                          data-type="material" data-stage="{{sIdx}}" data-index="{{index}}"
                                          data-field="widthRaw" placeholder="0" />
                                       <text class="unit-suffix">mm</text>
                                    </view>
                                 </view>
                                 <view class="field">
                                    <view class="label">涂宽 W<text class="sub">coat</text></view>
                                    <view class="input-wrap {{focus['s'+sIdx+'_m'+index+'_widthValid'] ? 'focused' : ''}} {{errors['s'+sIdx+'_m'+index+'_widthValid'] ? 'error' : ''}}">
                                       <input class="inp-inner" type="digit" value="{{item.widthValid}}"
                                          bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                          data-type="material" data-stage="{{sIdx}}" data-index="{{index}}"
                                          data-field="widthValid" placeholder="0" />
                                       <text class="unit-suffix">mm</text>
                                    </view>
                                 </view>
                              </view>
                              <view class="res-card-block mat" bindtap="calcMaterialItem" data-stage="{{sIdx}}"
                                 data-index="{{index}}">
                                 <view class="rc-left">
                                    <text class="rc-title">膜材单位成本 C<text class="sub">film</text></text>
                                    <text
                                       style="font-size:20rpx; color:#9ca3af; margin-left:10rpx; white-space:nowrap;">(纯膜材)</text>
                                 </view>
                                 <view class="rc-right">
                                    <text class="rc-val">¥ {{ (item.cost !== undefined && item.cost !== null) ?
                                       item.cost : '-' }}<text class="unit">/m²</text></text>
                                    <view class="rc-refresh"><ui-icon name="refresh" size="32" color="var(--text-sub)" /></view>
                                 </view>
                              </view>
                           </block>
                        </view>
                     </block>

                     <view class="add-bar">
                        <view class="btn-add-m" bindtap="addMaterial" data-stage="{{sIdx}}" data-type="film">+ 膜材</view>
                        <view class="btn-add-m glue" bindtap="addMaterial" data-stage="{{sIdx}}" data-type="glue">+ 胶层
                        </view>
                     </view>
                  </block>
               </view>

               <view class="sub-section process">
                  <view class="ss-head" bindtap="toggleSectionFold" data-stage="{{sIdx}}" data-section="proc">
                     <view class="ss-head-left">
                        <text class="ss-title">⚙️ 工艺成本计算</text>
                     </view>
                     <view class="ss-head-right">
                        <text class="ss-mini-cost" wx:if="{{stage.procFolded}}">¥ {{stage.stageProcCost || 0}}</text>
                        <view class="fold-icon small"><ui-icon name="{{stage.procFolded ? 'arrow-down' : 'arrow-up'}}" size="32" color="var(--text-sub)" /></view>
                     </view>
                  </view>

                  <block wx:if="{{!stage.procFolded}}">
                     <view class="proc-item">
                        <view class="row-Grid three-col">
                           <view class="field">
                              <view class="label">速度 V</view>
                              <view class="input-wrap {{focus['s'+sIdx+'_proc_speed'] ? 'focused' : ''}} {{errors['s'+sIdx+'_proc_speed'] ? 'error' : ''}}">
                                 <input class="inp-inner" type="digit" value="{{stage.process.speed}}"
                                    bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                    data-type="process" data-stage="{{sIdx}}" data-field="speed" placeholder="0" />
                                 <text class="unit-suffix">m/min</text>
                              </view>
                           </view>
                           <view class="field">
                              <view class="label">排产长度 L<text class="sub">odr</text></view>
                              <view class="input-wrap {{focus['s'+sIdx+'_proc_orderLen'] ? 'focused' : ''}} {{errors['s'+sIdx+'_proc_orderLen'] ? 'error' : ''}}">
                                 <input class="inp-inner" type="digit" value="{{stage.process.orderLen}}"
                                    bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                    data-type="process" data-stage="{{sIdx}}" data-field="orderLen" placeholder="0" />
                                 <text class="unit-suffix">m</text>
                              </view>
                           </view>
                           <view class="field">
                              <view class="label">调机损耗 L<text class="sub">wst</text></view>
                              <view class="input-wrap {{focus['s'+sIdx+'_proc_wasteLen'] ? 'focused' : ''}} {{errors['s'+sIdx+'_proc_wasteLen'] ? 'error' : ''}}">
                                 <input class="inp-inner" type="digit" value="{{stage.process.wasteLen}}"
                                    bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                    data-type="process" data-stage="{{sIdx}}" data-field="wasteLen" placeholder="0" />
                                 <text class="unit-suffix">m</text>
                              </view>
                           </view>
                        </view>

                        <view class="row-Grid">
                           <view class="field">
                              <view class="label">机台费 R<text class="sub">m</text></view>
                              <view class="input-wrap {{focus['s'+sIdx+'_proc_machRate'] ? 'focused' : ''}} {{errors['s'+sIdx+'_proc_machRate'] ? 'error' : ''}}">
                                 <input class="inp-inner" type="digit" value="{{stage.process.machRate}}"
                                    bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                    data-type="process" data-stage="{{sIdx}}" data-field="machRate" placeholder="0" />
                                 <text class="unit-suffix">元/h</text>
                                 <view class="calc-btn" bindtap="openMachCal" data-stage="{{sIdx}}"><ui-icon name="calc" size="36" color="var(--text-sub)" /></view>
                              </view>
                           </view>
                           <view class="field">
                              <view class="label">人工费 R<text class="sub">l</text></view>
                              <view class="input-wrap {{focus['s'+sIdx+'_proc_laborRate'] ? 'focused' : ''}} {{errors['s'+sIdx+'_proc_laborRate'] ? 'error' : ''}}">
                                 <input class="inp-inner" type="digit" value="{{stage.process.laborRate}}"
                                    bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
                                    data-type="process" data-stage="{{sIdx}}" data-field="laborRate" placeholder="0" />
                                 <text class="unit-suffix">元/h</text>
                                 <view class="calc-btn" bindtap="openLaborCal" data-stage="{{sIdx}}"><ui-icon name="calc" size="36" color="var(--text-sub)" /></view>
                              </view>
                           </view>
                        </view>

                        <view class="res-card-block proc" bindtap="calcProcessItem" data-stage="{{sIdx}}">
                           <view class="rc-left">
                              <text class="rc-title">加工单位成本 C<text class="sub">proc</text></text>
                              <text
                                 style="font-size:20rpx; color:#9ca3af; margin-left:10rpx; white-space:nowrap;">(纯加工)</text>
                           </view>
                           <view class="rc-right">
                              <text class="rc-val">¥ {{ (stage.stageProcCost && stage.stageProcCost!=0) ?
                                 stage.stageProcCost : '-' }}<text class="unit">/m²</text></text>
                              <view class="rc-refresh"><ui-icon name="refresh" size="32" color="var(--text-sub)" /></view>
                           </view>
                        </view>
                     </view>
                  </block>
               </view>

               <view class="stage-footer">
                  <view class="res-card-block sum" bindtap="calcStageTotal" data-stage="{{sIdx}}">
                     <view class="rc-left">
                        <text class="rc-title">本工序总单位成本 C<text class="sub">stage</text></text>
                        <text
                           style="font-size:20rpx; color:#9ca3af; margin-left:10rpx; font-weight:normal;">(不含良率)</text>
                     </view>
                     <view class="rc-right">
                        <text class="rc-val">¥ {{ (stage.stageTotalCost && stage.stageTotalCost!=0) ?
                           stage.stageTotalCost : '-' }}<text class="unit">/m²</text></text>
                        <view class="rc-refresh"><ui-icon name="refresh" size="32" color="var(--text-sub)" /></view>
                     </view>
                  </view>
                  <view class="res-card-block accum" bindtap="calcAccumCost" data-stage="{{sIdx}}">
                     <view class="rc-left">
                        <text class="rc-title">当前累计单位成本 C<text class="sub">accum</text></text>
                        <text
                           style="font-size:20rpx; color:#10b981; margin-left:10rpx; font-weight:normal;">(含良率)</text>
                     </view>
                     <view class="rc-right">
                        <text class="rc-val" style="color:#10b981">¥ {{ (stage.accumCost && stage.accumCost!=0) ?
                           stage.accumCost : '-' }}<text class="unit">/m²</text></text>
                        <view class="rc-refresh"><ui-icon name="refresh" size="32" color="var(--text-sub)" /></view>
                     </view>
                  </view>
               </view>
            </view>
         </view>
         <view class="flow-arrow" wx:if="{{sIdx < stages.length-1}}">⬇</view>
      </block>

      <button class="btn-add-stage" bindtap="addStage">+ 增加下道工序</button>
      <view class="footer-spacer-pro"></view>
   </scroll-view>

   <view class="floating-capsule-bar">
      <view class="fcb-content">
         <view class="fcb-left">
            <text class="fcb-label">总成本</text>
            <text class="fcb-currency">¥</text>
            <text class="fcb-val">{{res_final_cost}}</text>
            <text class="fcb-unit">/m²</text>
            <view class="fcb-separator"></view>
            <view class="fcb-tag" wx:if="{{final_yield !== '-'}}">直通率 {{final_yield}}%</view>
         </view>
         <view class="fcb-right">
            <button class="btn-float-calc" bindtap="calculateAll">开始计算</button>
         </view>
      </view>
   </view>

   <view class="modal-mask" wx:if="{{showMixModal}}" bindtap="closeMixModal">
      <view class="modal-card mix-card" catchtap="preventBubble">
         <view class="mc-head">
            <view style="display:flex;flex-direction:column;">
               <text>🧪 湿胶配方</text>
               <text wx:if="{{currentRecipeName}}" class="cur-recipe-tag">当前: {{currentRecipeName}}</text>
            </view>
            <view class="close-icon" bindtap="closeMixModal">×</view>
         </view>
         <view class="mix-toolbar">
            <button class="btn-load" bindtap="openLoadModal">📂 读取已有配方</button>
         </view>
         <scroll-view scroll-y class="mix-body">
            <view class="mix-head-row">
               <view style="flex:1.4" class="mix-head-cell">组分</view>
               <view style="flex:0.6" class="mix-head-cell">比例</view>
               <view style="flex:1.5" class="mix-head-cell">单价</view>
               <view style="flex:0.8" class="mix-head-cell">固含</view>
               <view style="width:40rpx"></view>
            </view>
            <block wx:for="{{mixList}}" wx:key="index">
               <view class="mix-row">
                  <view class="input-wrap mix {{focus['mix_'+index+'_name'] ? 'focused' : ''}}" style="flex:1.4">
                     <input class="inp-inner" value="{{item.name}}" bindinput="onMixInput"
                        bindfocus="onMixFocus" bindblur="onMixBlur"
                        data-index="{{index}}" data-field="name" placeholder="名称" />
                  </view>
                  <view class="input-wrap mix {{focus['mix_'+index+'_ratio'] ? 'focused' : ''}}" style="flex:0.6">
                     <input class="inp-inner" type="digit" value="{{item.ratio}}" bindinput="onMixInput"
                        bindfocus="onMixFocus" bindblur="onMixBlur"
                        data-index="{{index}}" data-field="ratio" placeholder="0" />
                  </view>
                  <view class="input-wrap mix {{focus['mix_'+index+'_price'] ? 'focused' : ''}}" style="flex:1.5">
                     <input class="inp-inner" type="digit" value="{{item.price}}" bindinput="onMixInput"
                        bindfocus="onMixFocus" bindblur="onMixBlur"
                        data-index="{{index}}" data-field="price" placeholder="0" />
                     <text class="unit-suffix">元/kg</text>
                  </view>
                  <view class="input-wrap mix {{focus['mix_'+index+'_solid'] ? 'focused' : ''}}" style="flex:0.8">
                     <input class="inp-inner" type="digit" value="{{item.solid}}" bindinput="onMixInput"
                        bindfocus="onMixFocus" bindblur="onMixBlur"
                        data-index="{{index}}" data-field="solid" placeholder="0" />
                     <text class="unit-suffix">%</text>
                  </view>
                  <view class="mix-del" bindtap="removeMixItem" data-index="{{index}}"><ui-icon name="close" size="28" color="var(--text-sub)" /></view>
               </view>
            </block>
            <button class="btn-add-mix" bindtap="addMixItem">+ 添加组分</button>
            <view class="mix-result-box">
               <view>加权单价: <text class="val">¥{{mixResultPrice}}</text></view>
               <view>理论固含: <text class="val">{{mixResultSolid}}%</text></view>
            </view>
         </scroll-view>
         <view class="mc-foot two-btn">
            <button class="btn-ghost" bindtap="closeMixModal">取消</button>
            <button class="btn-ghost" bindtap="handleApplyOnly">仅应用</button>
            <button class="btn-primary" bindtap="openSaveModal">保存并应用</button>
         </view>
      </view>
   </view>

   <confirm-modal show="{{showClearModal}}" title="清空确认" content="确定要清空当前页面的所有输入数据吗？此操作无法撤销。" confirmDanger="{{true}}"
      bind:cancel="closeClearModal" bind:confirm="doClearAll" />

   <view class="modal-mask" wx:if="{{showLoadModal}}" bindtap="closeLoadModal">
      <view class="modal-card clear-card" catchtap="preventBubble">
         <view class="cc-title">选择配方</view>
         <scroll-view scroll-y class="load-list">
            <view class="load-item" wx:for="{{savedRecipeList}}" wx:key="index">
               <view class="li-main" bindtap="doLoadRecipe" data-index="{{index}}">
                  <text class="li-name">{{item.name}}</text>
                  <text class="li-price">¥{{item.price}}</text>
               </view>
               <view class="li-del" catchtap="requestDeleteRecipe" data-index="{{index}}"><ui-icon name="trash" size="32" color="var(--text-sub)" /></view>
            </view>
         </scroll-view>
         <view class="cc-btns">
            <button class="btn-ghost" bindtap="closeLoadModal" style="width:100%">取消</button>
         </view>
      </view>
   </view>

   <view class="modal-mask" wx:if="{{showSaveModal}}" bindtap="closeSaveModal">
      <view class="modal-card clear-card" catchtap="preventBubble">
         <view class="cc-title">保存配方</view>
         <view class="input-wrap save {{focus.save_name ? 'focused' : ''}}">
            <input class="inp-inner" placeholder="请输入配方名称" value="{{tempRecipeName}}"
               bindinput="onInput" bindfocus="onModalFocus" bindblur="onModalBlur"
               data-modal="save" data-field="name" />
         </view>
         <view class="cc-btns">
            <button class="btn-ghost" bindtap="closeSaveModal">取消</button>
            <button class="btn-primary" bindtap="doSaveRecipe">确认</button>
         </view>
      </view>
   </view>

   <view class="modal-mask" wx:if="{{showOverwriteModal}}" bindtap="closeOverwriteModal">
      <view class="modal-card clear-card" catchtap="preventBubble">
         <view class="cc-title">配方已存在</view>
         <view class="cc-desc">是否覆盖原配方 "{{pendingSaveName}}"？\n还是存为新副本？</view>
         <view class="cc-btns">
            <button class="btn-ghost" bindtap="confirmSaveAsNew">存为副本</button>
            <button class="btn-primary" bindtap="confirmOverwrite">覆盖</button>
         </view>
      </view>
   </view>

   <confirm-modal show="{{showDeleteModal}}" title="删除确认" content="确定删除该配方吗？" confirmText="删除" confirmDanger="{{true}}"
      bind:cancel="closeDeleteModal" bind:confirm="doDeleteRecipe" />

   <view class="modal-mask" wx:if="{{showFormulaModal}}" bindtap="closeFormula">
      <view class="modal-card formula-card" catchtap="preventBubble">
         <view class="fc-head">
            <view style="flex:1"></view> <!-- Spacer -->
            <view class="fc-title-main">{{formulaTitle}}</view>
            <view style="flex:1; display:flex; justify-content:flex-end;">
               <view class="close-icon" bindtap="closeFormula">×</view>
            </view>
         </view>
         <scroll-view scroll-y class="fc-body">
            <block wx:for="{{formulaContent}}" wx:key="index">
               <view class="fc-block">
                  <view class="fc-subtitle gradient-text">{{item.title}}</view>
                  <view class="formula-inline" wx:if="{{item.inlineMath}}">
                     <block wx:for="{{item.inlineMath}}" wx:for-item="x" wx:key="idx">
                        <text>{{x.v}}</text><text class="sub" wx:if="{{x.s}}">{{x.s}}</text>
                     </block>
                  </view>
                  <view class="formula-inline" wx:elif="{{item.displayInline}}">
                     <text>{{item.displayInline}}</text>
                  </view>
                  <view class="formula-display" wx:if="{{item.f}}">
                     <view class="eqn-lhs" wx:if="{{item.lhs}}">
                        <block wx:for="{{item.lhs}}" wx:for-item="x" wx:key="idx">
                           <text>{{x.v}}</text><text class="sub" wx:if="{{x.s}}">{{x.s}}</text>
                        </block>
                        <text class="eqn-eq">=</text>
                     </view>
                     <view class="fraction">
                        <view class="num">
                           <block wx:for="{{item.f.n}}" wx:for-item="x" wx:key="idx">
                              <text>{{x.v}}</text><text class="sub" wx:if="{{x.s}}">{{x.s}}</text>
                           </block>
                        </view>
                        <view class="line"></view>
                        <view class="den">
                           <block wx:for="{{item.f.d}}" wx:for-item="x" wx:key="idx">
                              <text>{{x.v}}</text><text class="sub" wx:if="{{x.s}}">{{x.s}}</text>
                           </block>
                        </view>
                     </view>
                  </view>
                  <view class="fc-vars" wx:if="{{item.vars}}">
                     <view class="fv-row" wx:for="{{item.vars}}" wx:for-item="v" wx:key="k">
                        <view class="fv-k">
                           <block wx:for="{{v.k}}" wx:for-item="x" wx:key="idx">
                              <text>{{x.v}}</text><text class="sub" wx:if="{{x.s}}">{{x.s}}</text>
                           </block>
                        </view>
                        <text class="fv-colon">:</text>
                        <text class="fv-desc">{{v.desc}}</text>
                        <text class="fv-u" wx:if="{{v.u}}">({{v.u}})</text>
                     </view>
                  </view>
               </view>
               <view class="fc-divider" wx:if="{{index < formulaContent.length-1}}"></view>
            </block>
            <view class="fc-logic-box" wx:if="{{formulaContent[0].logic}}">
               <view class="logic-title">逻辑推导：</view>
               <view class="logic-list">
                  <view class="logic-item" wx:for="{{formulaContent[0].logic}}" wx:key="*this">
                     <text user-select="true" decode="true">{{index+1}}. {{item}}</text>
                  </view>
               </view>
            </view>
         </scroll-view>
      </view>
   </view>

   <view class="modal-mask" wx:if="{{showMachModal}}" bindtap="closeMachModal">
      <view class="modal-card mix-card" catchtap="preventBubble">
         <view class="mc-head">
            <text>🧮 机台费率估算</text>
            <view class="close-icon" bindtap="closeMachModal">×</view>
         </view>
         <scroll-view scroll-y class="mix-body">
            <view class="modal-field-row">
               <view class="field-col">
                  <text class="f-label">C<text class="sub">fix</text> 月固定总开销</text>
                  <text class="f-sub">含设备折旧、房租、管理分摊</text>
               </view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.mach_fixCost ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{machCalc.fixCost}}"
                        bindinput="onMachInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="mach" data-field="fixCost" placeholder="0" />
                     <text class="unit-suffix">元/月</text>
                  </view>
               </view>
            </view>
            <view class="modal-field-row">
               <view class="field-col">
                  <text class="f-label">N<text class="sub">line</text> 分摊线体数</text>
                  <text class="f-sub">若是车间总开销，填总线数</text>
               </view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.mach_lines ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{machCalc.lines}}"
                        bindinput="onMachInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="mach" data-field="lines" placeholder="0" />
                     <text class="unit-suffix">条</text>
                  </view>
               </view>
            </view>
            <view class="fc-divider"></view>

            <view class="modal-field-row">
               <view class="field-col"><text class="f-label">D 月工作天数</text></view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.mach_days ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{machCalc.days}}"
                        bindinput="onMachInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="mach" data-field="days" placeholder="0" />
                     <text class="unit-suffix">天</text>
                  </view>
               </view>
            </view>
            <view class="modal-field-row">
               <view class="field-col"><text class="f-label">H 日排班小时</text></view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.mach_hours ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{machCalc.hours}}"
                        bindinput="onMachInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="mach" data-field="hours" placeholder="0" />
                     <text class="unit-suffix">h</text>
                  </view>
               </view>
            </view>
            <view class="modal-field-row">
               <view class="field-col">
                  <text class="f-label">η 目标稼动率</text>
                  <text class="f-sub">有效生产时间占比</text>
               </view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.mach_util ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{machCalc.util}}"
                        bindinput="onMachInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="mach" data-field="util" placeholder="0" />
                     <text class="unit-suffix">%</text>
                  </view>
               </view>
            </view>
            <view class="fc-divider"></view>

            <view class="modal-field-row">
               <view class="field-col">
                  <text class="f-label">C<text class="sub">run</text> 运行时能耗</text>
                  <text class="f-sub">开机状态下的电费+气费</text>
               </view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.mach_runCost ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{machCalc.runCost}}"
                        bindinput="onMachInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="mach" data-field="runCost" placeholder="0" />
                     <text class="unit-suffix">元/h</text>
                  </view>
               </view>
            </view>

            <view class="formula-box">
               <view class="fb-title">计算公式：</view>
               <view class="fb-math">R<text class="sub">m</text> = (C<text class="sub">fix</text> / (N<text
                     class="sub">line</text> · D · H · η)) + C<text class="sub">run</text></view>
               <view class="fb-res">计算结果: <text class="val">{{machCalc.result}}</text> 元/h</view>
            </view>
         </scroll-view>
         <view class="mc-foot two-btn">
            <button class="btn-ghost" bindtap="closeMachModal">取消</button>
            <button class="btn-primary" bindtap="applyMachResult">应用结果</button>
         </view>
      </view>
   </view>

   <view class="modal-mask" wx:if="{{showLaborModal}}" bindtap="closeLaborModal">
      <view class="modal-card mix-card" catchtap="preventBubble">
         <view class="mc-head">
            <text>👷 人工费率估算</text>
            <view class="close-icon" bindtap="closeLaborModal">×</view>
         </view>
         <scroll-view scroll-y class="mix-body">
            <view class="modal-field-row">
               <view class="field-col">
                  <text class="f-label">P 班组总人数</text>
                  <text class="f-sub">机长+主手+辅助+调胶等</text>
               </view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.labor_headcount ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{laborCalc.headcount}}"
                        bindinput="onLaborInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="labor" data-field="headcount" placeholder="0" />
                     <text class="unit-suffix">人</text>
                  </view>
               </view>
            </view>
            <view class="modal-field-row">
               <view class="field-col">
                  <text class="f-label">S 人均综合月薪</text>
                  <text class="f-sub">含工资、社保、食宿福利等</text>
               </view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.labor_salary ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{laborCalc.salary}}"
                        bindinput="onLaborInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="labor" data-field="salary" placeholder="0" />
                     <text class="unit-suffix">元/月</text>
                  </view>
               </view>
            </view>
            <view class="fc-divider"></view>

            <view class="modal-field-row">
               <view class="field-col"><text class="f-label">D 月工作天数</text></view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.labor_days ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{laborCalc.days}}"
                        bindinput="onLaborInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="labor" data-field="days" placeholder="0" />
                     <text class="unit-suffix">天</text>
                  </view>
               </view>
            </view>
            <view class="modal-field-row">
               <view class="field-col"><text class="f-label">H 日排班小时</text></view>
               <view class="field-col right">
                  <view class="input-wrap modal {{focus.labor_hours ? 'focused' : ''}}">
                     <input class="inp-inner" type="digit" value="{{laborCalc.hours}}"
                        bindinput="onLaborInput" bindfocus="onModalFocus" bindblur="onModalBlur"
                        data-modal="labor" data-field="hours" placeholder="0" />
                     <text class="unit-suffix">h</text>
                  </view>
               </view>
            </view>

            <view class="formula-box">
               <view class="fb-title">计算公式：</view>
               <view class="fb-math">R<text class="sub">l</text> = (P · S) / (D · H)</view>
               <view class="fb-res">计算结果: <text class="val">{{laborCalc.result}}</text> 元/h</view>
            </view>
         </scroll-view>
         <view class="mc-foot two-btn">
            <button class="btn-ghost" bindtap="closeLaborModal">取消</button>
            <button class="btn-primary" bindtap="applyLaborResult">应用结果</button>
         </view>
      </view>
   </view>

   <!-- 历史记录弹窗 -->
   <view class="modal-mask" wx:if="{{showHistoryModal}}" bindtap="closeHistoryModal">
      <view class="modal-card history-card" catchtap="preventBubble">
         <view class="mc-head">历史记录</view>
         <scroll-view scroll-y class="history-scroll">
            <block wx:if="{{localHistory.length > 0}}">
               <view class="history-item" wx:for="{{localHistory}}" wx:key="id" bindtap="restoreHistory"
                  data-index="{{index}}">
                  <view class="hi-del-btn" catchtap="deleteHistoryItem" data-id="{{item.id}}">×</view>
                  <view class="hi-time">{{item.time}}</view>
                  <view class="hi-data">
                     <view class="hi-row" wx:for="{{item.data}}" wx:key="k" wx:for-item="sub">
                        <text class="hi-k">{{sub.k}}</text>
                        <text class="hi-v">{{sub.v}}</text>
                     </view>
                  </view>
               </view>
            </block>
            <view class="empty-hint" wx:else>暂无历史记录</view>
         </scroll-view>
         <view class="mc-foot">
            <button class="hi-close-btn" bindtap="closeHistoryModal">关闭</button>
         </view>
      </view>
   </view>
   <confirm-modal show="{{showDeleteModal}}" title="删除确认" content="确定要删除这条记录吗？" confirmDanger="{{true}}"
      bind:confirm="confirmDelete" bind:cancel="cancelDelete" />
</view>