  margin-bottom: 20rpx;
  line-height: 1.2;
  text-align: left;
  /* Explicit Left Align */
}

.formula-display {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
  padding: 20rpx 0;
  background: transparent;
  /* Remove background */
