  letter-spacing: 2rpx;
}

.eqn-lhs {
  font-family: "Times New Roman", serif;
  font-size: 36rpx;
  margin-right: 15rpx;
  color: var(--text);
  /* Neutral Color */
  display: flex;
  align-items: center;
}

.eqn-eq {
  margin: 0 10rpx;
  color: var(--text-sub);
}

.fraction {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-family: "Times New Roman", serif;
  color: var(--text);
  /* Neutral Color */
}

.num {
  border-bottom: 1px solid var(--text);
  /* Neutral Line */
  padding: 0 15rpx;
  margin-bottom: 4rpx;
  font-size: 32rpx;
  min-width: 100%;
  text-align: center;
  white-space: nowrap;
}

.den {
  font-size: 32rpx;
  text-align: center;
  white-space: nowrap;
}

.line {
  display: none;
}

/* 变量容器样式 - 彻底去背景 */
.fc-vars {
  background: transparent;
  /* No Background */
  padding: 0;
  border-radius: 0;
  margin-bottom: 25rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx 20rpx;
}

/* 修改单行样式 */
.fv-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  margin-bottom: 0;
}

.fv-k {
  font-weight: bold;
  color: var(--primary);
  /* Theme Color (Green) */
  font-family: "Times New Roman", serif;
  font-style: italic;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-right: 15rpx;
  /* Add spacing since colon is gone */
}

.fv-colon {
  display: none;
  /* Remove colon */
}

.fv-desc {
  color: var(--text);
}

.fv-u {
  color: var(--text-sub);
  margin-left: 8rpx;
  font-size: 22rpx;
}

.fc-divider {
  height: 1px;
  background: var(--border);
  margin: 25rpx 0;
  border: none;
}

.fc-logic-box {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px dashed var(--border);
  display: block;
  text-align: left;
  width: 100%;
  box-sizing: border-box;
}

.logic-title {
  font-size: 26rpx;
  color: var(--primary);
  /* Theme Color (Green) */
  font-weight: bold;
  margin-bottom: 15rpx;
  width: auto;
  /* Reset width */
  margin-left: 0;
  /* Reset margin */
  margin-right: 0;
  /* Reset margin */
  text-align: left;
}

.logic-list {
  display: block;
  width: 100%;
  overflow: hidden;
}

.logic-item {
  display: block;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 12rpx;
  word-break: break-all;
  overflow-wrap: break-word;
}

.li-idx {
  font-weight: bold;
  color: var(--text-sub);
}

.li-txt {
  /* 无需特殊样式，跟随父元素布局 */
}

.clear-card {
  width: 80%;
  background: var(--card);
  text-align: center;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
}

.cc-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text);
  margin-bottom: 20rpx;
}

.cc-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 40rpx;
}

.cc-btns {
  display: flex;
  gap: 30rpx;
}

.save-inp {
  border: 1px solid var(--border);
  background: var(--input-bg);
  height: 80rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 40rpx;
  color: var(--text);
  text-align: left;
}

.load-list {
  max-height: 50vh;
  margin-bottom: 30rpx;
  text-align: left;
}

.load-item {
  padding: 20rpx;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.load-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.li-name {
  font-size: 28rpx;
  color: var(--text);
}

.li-price {
  color: var(--primary);
  font-weight: bold;
  font-size: 28rpx;
}

.li-main {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-right: 20rpx;
}

.li-del {
  padding: 10rpx;
  font-size: 32rpx;
  color: #ef4444;
  opacity: 0.8;
  display: flex;
  align-items: center;
}

.modal-field-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.field-col {
  display: flex;
  flex-direction: column;
}

.field-col.right {
  align-items: flex-end;
  min-width: 40%;
}

.f-label {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text);
  margin-bottom: 4rpx;
}

.f-sub {
  font-size: 20rpx;
  color: #666;
}

.f-unit {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.formula-box {
  background: rgba(255, 255, 255, 0.05);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
  border: 1px dashed var(--border);
}

.page-container.light .formula-box {
  background: rgba(16, 185, 129, 0.08);
  border-color: rgba(16, 185, 129, 0.3);
}

.fb-title {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.fb-math {
  font-family: "Times New Roman", serif;
  font-style: italic;
  color: #34d399;
  font-size: 26rpx;
  margin-bottom: 15rpx;
}

.fb-res {
  font-weight: bold;
  font-size: 28rpx;
}

.fb-res .val {
  color: #34d399;
  font-size: 34rpx;
  margin: 0 10rpx;
}

.compact-row {
  padding-right: 0;
}

/* 保存按钮优化 - 更小、更紧凑 */
.btn-float-save {
  background: rgba(16, 185, 129, 0.15);
  color: var(--primary);
  border: 1px solid var(--primary);
  border-radius: 50%;
  width: 70rpx;
  height: 70rpx;
  padding: 0;
  font-size: 32rpx;
  margin-right: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}

.btn-float-save:active {
  opacity: 0.8;
  transform: scale(0.95);
}

/* 历史弹窗样式优化 */
.history-card {
  width: 90%;
}

.history-card .mc-head {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.history-card .mc-foot {
  justify-content: center;
}

.hi-close-btn {
  background: transparent !important;
  border: 1px solid var(--border) !important;
  color: var(--text-sub) !important;
  font-size: 26rpx !important;
  padding: 0 40rpx !important;
  border-radius: 16rpx !important;
  height: 76rpx !important;
  line-height: 76rpx !important;
  width: auto !important;
}

.history-scroll {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 20rpx;
  min-height: 0;
}

.history-item {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
  border: 1px solid var(--border);
  transition: all 0.2s;
  position: relative;
}

.history-item:active {
  transform: scale(0.98);
  opacity: 0.9;
  background: rgba(16, 185, 129, 0.05);
}

.hi-time {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hi-time::before {
  content: '🕒';
  font-size: 18rpx;
}

.hi-data {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hi-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1px dashed rgba(255, 255, 255, 0.05);
}

.hi-row:last-child {
  border-bottom: none;
}

.hi-k {
  font-size: 22rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

.hi-v {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: bold;
  text-align: right;
  font-family: "DIN Alternate", sans-serif;
}

.empty-hint {
  text-align: center;
  color: var(--text-sub);
  padding: 80rpx 0;
  font-size: 26rpx;
  opacity: 0.6;
}

/* --- History Delete Style --- */
.history-item {
  padding-right: 24rpx;
  position: relative;
}

.hi-del {
  display: none;
  /* 旧样式隐藏 */
}

/* --- 历史记录删除按钮样式 --- */
.hi-del-btn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  color: var(--text-sub);
  font-size: 36rpx;
  line-height: 1;
  padding: 8rpx;
  opacity: 0.5;
}

.hi-del-btn:active {
  opacity: 1;
  color: #ef4444;
}