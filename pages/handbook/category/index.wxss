/* 分类页面样式 */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  /* 手册专属主题色 */
  --primary: #6366f1;
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
}

/* 固定头部 - 单行沉浸式设计 */
.category-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg); /* 沉浸式：与页面背景一致 */
  /* 移除border-bottom */
  box-sizing: border-box;
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx; /* 统一标准：24rpx */
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

/* 返回/首页按钮：专业轻量级设计 */
.header-back, .header-home {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 移除背景和边框 */
}

.back-icon {
  font-size: 36rpx;
  color: var(--text-sub);
  font-weight: 300;
}

.home-icon {
  font-size: 24rpx;
  opacity: 0.6;
}

.header-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 搜索框 */
.search-box {
  padding: 20rpx 30rpx 10rpx; /* 调整下边距 */
  background: var(--bg);
  position: sticky;
  top: 44px; /* header height ? no, dynamic. Sticky under header requires knowing header height */
  /* Remove sticky here if header is sticky */
  z-index: 90;
}

.search-input-wrapper {
  background: var(--card);
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border: 1px solid var(--border);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--text);
  background: transparent;
}

.search-placeholder {
  color: var(--text-sub);
  opacity: 0.5;
}

.clear-icon {
  font-size: 26rpx;
  color: var(--text-sub);
  opacity: 0.5;
  padding: 10rpx;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  padding: 0 30rpx;
  box-sizing: border-box; /* 修复溢出问题 */
  width: 100%;
}

.scroll-footer {
  height: 100rpx;
}

/* 子分类列表 */
.subcategory-list {
  padding-top: 20rpx;
}

.subcategory-section {
  margin-bottom: 40rpx;
  /* Frontend Design Skill: Layout Control */
  width: 100%;
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
}

.term-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 20rpx;
  width: 100%;
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-icon-img {
  width: 48rpx;
  height: 48rpx;
}



.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text);
}

.section-count {
  font-size: 22rpx;
  color: var(--text-sub);
  opacity: 0.6;
  margin-left: auto;
}

.section-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  display: flex;
  flex-direction: column; /* 分行显示 */
  align-items: flex-start;
  transition: transform 0.2s;
}

.item-card:active {
  transform: scale(0.98);
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  width: 100%;
  color: var(--text);
  margin-bottom: 8rpx;
}

.item-brief {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-left: 0; /* 清除左边距 */
  opacity: 0.8;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-arrow {
  display: none; /* 移除箭头 */
}

/* 词条列表 */
.term-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 20rpx;
}

.term-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx;
  transition: transform 0.2s;
}

.term-card:active {
  transform: scale(0.98);
}

.term-main {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.term-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text);
}

.term-english {
  font-size: 24rpx;
  color: var(--primary);
  opacity: 0.8;
}

.term-definition {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
  opacity: 0.6;
}

/* 词条详情弹窗 */
.term-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.term-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
}

.modal-content {
  position: relative;
  width: 100%;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  max-height: 70vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.term-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text);
}

.modal-english {
  font-size: 26rpx;
  color: var(--primary);
  margin-top: 8rpx;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.modal-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-label {
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 500;
}

.section-content {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
}

.related-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.related-tag {
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(99, 102, 241, 0.1); /* Indigo 0.1 */
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
}

.modal-footer {
  margin-top: 40rpx;
}

.btn-close {
  width: 100%;
  height: 88rpx;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 20rpx;
  color: var(--text-sub);
  font-size: 30rpx;
}

.btn-close::after {
  border: none;
}
