@import "../../../styles/nav-header.wxss";

/* 详情页样式 */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  /* 手册专属主题色 */
  --primary: #6366f1;
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
}

/* 首页按钮紧凑样式 - 与返回按钮形成操作组 */
.home-btn {
  margin-left: -16rpx !important; /* 完全抵消 gap */
  padding: 4rpx 8rpx !important; /* 更紧凑 */
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
  flex-shrink: 0;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  width: 100%;
  padding: 30rpx;
  box-sizing: border-box; /* 确保padding不撑大宽度 */
}

.content-section {
  margin-bottom: 40rpx;
  /* Frontend Design Skill: Controlled Layout */
  width: 100%;
  max-width: 640px; /* 限制最大宽度优化大屏体验 */
  margin-left: auto;
  margin-right: auto;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary);
}

/* 文本内容 */
.section-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text);
}

/* 表格 - 移动端自适应布局 (无横向滚动) */
.section-table {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.table-scroll {
  width: 100%;
}

.table-inner {
  width: 100%; /* 核心：铺满屏幕，禁止强制撑开 */
}

.table-header {
  display: flex;
  background: rgba(99, 102, 241, 0.08);
  width: 100%;
  border-bottom: 1px solid var(--border);
}

.table-header .table-cell {
  font-weight: 600;
  color: var(--primary);
  font-size: 26rpx;
  padding: 20rpx 16rpx;
}

.table-row {
  display: flex;
  border-bottom: 1px solid var(--border);
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  flex: 1; /* 均分空间，内容多自动换行 */
  padding: 24rpx 16rpx; /* 增加舒适度 */
  font-size: 26rpx;
  color: var(--text);
  text-align: left; /* 核心：左对齐 */
  line-height: 1.5; /* 优化多行阅读 */
  word-break: break-all; /* 防止长单词撑破 */
  display: flex;
  align-items: center; /* 垂直居中 */
}

/* 智能列宽优化 */
/* 默认情况：首列30% (适用于所有2-3列表格及非Testing模块的4列表格) */
.section-table .table-row .table-cell:first-child,
.section-table .table-header .table-cell:first-child {
  flex: 0 0 30%;
}

/* 特殊列宽：仅针对 Testing 模块的4列宽表格 (测试方法表) */
/* 收窄首列 (18%)，加宽设备列 (32%) */
.category-testing .col-4 .table-row .table-cell:first-child,
.category-testing .col-4 .table-header .table-cell:first-child {
  flex: 0 0 18%;
}

.category-testing .col-4 .table-row .table-cell:nth-child(2),
.category-testing .col-4 .table-header .table-cell:nth-child(2) {
  flex: 0 0 32%;
}

/* 剩下的列自动平分剩余70% */

/* 公式 */
.section-formula {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  padding: 28rpx;
}

/* 默认模式 (Dark by default based on app.wxss) */
.formula-box {
  border-radius: 12rpx;
  padding: 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);

  /* Dark Mode Styles (Default) */
  background: #1f2937;
  color: #ffffff;
  border: 1px solid #374151;
}

/* 浅色模式适配 (Light Mode Override) */
.page-container.light .formula-box {
  background: #ffffff;
  color: #000000;
  border: 1px solid #e5e7eb;
}

.formula-text {
  font-size: 32rpx;
  font-family: 'Times New Roman', serif;
  color: var(--text);
  letter-spacing: 2rpx;
}

.formula-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.formula-params {
  display: table; /* 核心方案：表格布局 - 让每组公式根据内容自适应列宽 */
  width: 100%;
  border-spacing: 0 12rpx; /* 模拟 gap: 12rpx */
  margin-left: 0; /* 移除之前的左移 hack */
}

.param-item {
  display: table-row; /* 表格行 */
  /* gap 在 table-row 无效，使用 border-spacing */
}

.param-symbol {
  display: table-cell; /* 表格单元格 */
  width: auto; /* 关键修复：自然宽度，防止压缩换行 */
  white-space: nowrap; /* 必须：禁止换行 */
  text-align: right; /* Axis Alignment */
  padding-right: 16rpx;
  vertical-align: middle;
}

.param-desc {
  display: table-cell;
  vertical-align: middle;
  text-align: left;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.4;
}

/* 列表 */
.section-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.list-bullet {
  color: var(--primary);
  font-size: 28rpx;
  line-height: 1.6;
}

.list-text {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
  flex: 1;
}

/* 提示框 */
.section-tip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.section-tip.info {
  background: rgba(59, 130, 246, 0.1);
}

.section-tip.warning {
  background: rgba(245, 158, 11, 0.1);
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text);
  flex: 1; /* 自适应宽度 */
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
  /* Frontend Design Skill: Layout Control */
  width: 100%;
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
  opacity: 0.6;
}

/* 顶部留白 */
.content-footer {
  height: 100rpx;
}

/* ================== Analysis Block (V6.0) ================== */
.section-analysis {
  margin: 24rpx 0;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 8rpx;
  padding: 16rpx;
}

.analysis-header-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
  border-left: 4rpx solid var(--primary);
  padding-left: 10rpx;
}

.analysis-header {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text);
}

.analysis-subtitle {
  font-size: 20rpx;
  color: var(--text-sub);
}

.analysis-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* Increased gap for better separation */
}

.analysis-item {
  display: flex;
  align-items: flex-start; /* Professional: Align with Title (First Line) */
}

.fail-tag-wrapper {
  width: 120rpx; /* Increased from 80rpx to fit "Lock-up" */
  flex-shrink: 0;
  margin-right: 16rpx;
  display: flex;
  justify-content: center;
  padding-top: 2rpx; /* Optical: Align tag baseline with Title text */
}

.fail-tag {
  font-size: 22rpx;
  padding: 6rpx 10rpx; /* Increased padding */
  border-radius: 6rpx;
  width: 100%; /* Fill wrapper */
  box-sizing: border-box;
  text-align: center;
  font-weight: bold;
  font-family: monospace; /* Code-like look */
  white-space: nowrap; /* Prevent wrap */
  overflow: hidden;
  text-overflow: ellipsis; /* Handle extreme cases */
}

.tag-success {
  background: rgba(48, 209, 88, 0.15);
  color: #30d158;
  border: 1rpx solid rgba(48, 209, 88, 0.3);
}

.tag-error {
  background: rgba(255, 69, 58, 0.15);
  color: #ff453a;
  border: 1rpx solid rgba(255, 69, 58, 0.3);
}

.tag-info {
  background: rgba(10, 132, 255, 0.15);
  color: #0a84ff;
  border: 1rpx solid rgba(10, 132, 255, 0.3);
}

.tag-warning {
  background: rgba(255, 159, 10, 0.15);
  color: #ff9f0a;
  border: 1rpx solid rgba(255, 159, 10, 0.3);
}

.fail-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.fail-label {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text);
}

.fail-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.4;
}
