<view class="page-container {{theme}} category-{{category}}">
  <!-- 固定头部 - 统一单行设计 -->
  <view class="page-header" style="padding-top: {{statusBarHeight}}px;">
    <!-- 导航行 -->
    <view class="nav-row">
      <view class="back-btn" bindtap="goBack">
         <ui-icon name="back" size="50" />
      </view>
      <view class="tool-btn home-btn" bindtap="goHome">
         <ui-icon name="home" size="44" />
      </view>
      <text class="page-title">{{title}}</text>
    </view>
  </view>

  <!-- 内容区域 -->
  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 内容段落 -->
    <block wx:for="{{sections}}" wx:key="index">
      <view class="content-section">
        <view class="section-header" wx:if="{{item.title && item.type !== 'standard-card' && item.type !== 'analysis-block'}}">
          <text class="section-title">{{item.title}}</text>
        </view>

        <!-- 自定义组件: 涂布窗口图 -->
        <view class="section-custom" wx:if="{{item.type === 'custom-coating-window'}}">
          <coating-window-chart theme="{{theme}}" />
        </view>

        <!-- 文本内容 -->
        <view class="section-text" wx:if="{{item.type === 'text'}}">
          <text>{{item.content}}</text>
        </view>

        <!-- 表格内容 -->
        <view class="section-table col-{{item.headers.length}}" wx:if="{{item.type === 'table'}}">
          <scroll-view scroll-x class="table-scroll" enable-flex>
            <view class="table-inner">
              <view class="table-header">
                <text class="table-cell" wx:for="{{item.headers}}" wx:key="*this" wx:for-item="header">{{header}}</text>
              </view>
              <view class="table-row" wx:for="{{item.rows}}" wx:key="index" wx:for-item="row">
                <text class="table-cell" wx:for="{{row}}" wx:key="*this" wx:for-item="cell">{{cell}}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- 公式内容 -->
        <view class="section-formula" wx:if="{{item.type === 'formula'}}">
          <view class="formula-box">
            <latex-formula formula="{{item.formula}}" />
          </view>
          <view class="formula-desc" wx:if="{{item.description}}">
            <text>{{item.description}}</text>
          </view>
          <view class="formula-params" wx:if="{{item.params && item.params.length > 0}}">
            <view class="param-item" wx:for="{{item.params}}" wx:key="symbol" wx:for-item="param">
              <view class="param-symbol">
                <latex-formula formula="{{param.symbol}}" color="var(--primary)" />
              </view>
              <text class="param-desc">{{param.desc}}</text>
            </view>
          </view>
        </view>

        <!-- 列表内容 -->
        <view class="section-list" wx:if="{{item.type === 'list'}}">
          <view class="list-item" wx:for="{{item.items}}" wx:key="*this" wx:for-item="listItem">
            <text class="list-bullet">•</text>
            <text class="list-text">{{listItem}}</text>
          </view>
        </view>

        <!-- 提示框 -->
        <view class="section-tip {{item.tipType || 'info'}}" wx:if="{{item.type === 'tip'}}">
          <text class="tip-icon">{{item.tipType === 'warning' ? '⚠️' : '💡'}}</text>
          <text class="tip-text">{{item.content}}</text>
        </view>

        <!-- V6.0 新增: 矢量原理图 -->




        <!-- V6.0 新增: 标准参数卡 -->
        <view class="section-card" wx:if="{{item.type === 'standard-card'}}">
             <standard-card title="{{item.title}}" items="{{item.items}}" />
        </view>

        <!-- V6.0 新增: 失效分析板块 -->
        <view class="section-analysis" wx:if="{{item.type === 'analysis-block'}}">
             <view class="analysis-header-row">
                <view class="analysis-header" wx:if="{{item.title}}">{{item.title}}</view>
                <view class="analysis-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
             </view>
             <view class="analysis-grid">
               <view class="analysis-item" wx:for="{{item.items}}" wx:key="mode" wx:for-item="failItem">
                 <!-- Left: Code Tag -->
                 <view class="fail-tag-wrapper">
                    <view class="fail-tag {{failItem.tagType ? failItem.tagType : (failItem.mode === 'AF' ? 'tag-success' : 'tag-error')}}">{{failItem.mode}}</view>
                 </view>
                 <!-- Right: Content -->
                 <view class="fail-content">
                    <view class="fail-label">{{failItem.label}}</view>
                    <view class="fail-desc">{{failItem.desc}}</view>
                 </view>
               </view>
             </view>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{sections.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">内容开发中...</text>
    </view>

    <!-- 底部留白 -->
    <view class="content-footer"></view>
  </scroll-view>
</view>
