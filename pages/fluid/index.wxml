<view class="page-container {{theme}} theme-fluid">
  <!-- 双排导航栏：专业紧凑设计 -->
  <view class="page-header" style="padding-top: {{statusBarHeight}}px;">
    <!-- 第一行：标题栏 -->
    <view class="nav-row">
      <view class="back-btn" bindtap="goBack">
         <ui-icon name="back" size="50" />
      </view>
      <text class="page-title">流体力学计算</text>
    </view>

    <!-- 第二行：纯图标工具栏 -->

    <view class="toolbar-row">
      <view class="tool-btn" bindtap="toggleFormula" hover-class="tool-hover">
        <ui-icon name="sigma" />
      </view>
      <view class="tool-btn" bindtap="openHistoryModal" hover-class="tool-hover">
        <ui-icon name="history" />
      </view>
      <view class="tool-btn" bindtap="saveHistory" wx:if="{{result.hasResult}}" hover-class="tool-hover">
        <ui-icon name="save" color="var(--primary)" />
      </view>
      <view class="tool-btn" bindtap="confirmReset" hover-class="tool-hover">
         <ui-icon name="trash" />
      </view>
    </view>
  </view>

  <ui-card customStyle="{{isPowerLaw ? 'padding-bottom: 12rpx;' : ''}}">
    <!-- Custom Header with Switch -->
    <view class="card-header-row" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12rpx;">
       <view class="section-title" style="margin:0;">流体属性 (Fluid)</view>
       <view style="display:flex; align-items:center;">
          <text style="font-size:22rpx; color:var(--text-sub); margin-right:8rpx">非牛顿流体</text>
          <switch checked="{{isPowerLaw}}" bindchange="toggleModel" color="#3b82f6" style="transform: scale(0.65);" />
       </view>
    </view>

    <!-- Row 1: Density | Viscosity or K -->
    <view class="form-row">
       <view class="form-col">
          <ui-form-field label="湿胶密度 ρ" fieldName="rho_wet" data-field="rho_wet" value="{{rho_wet}}" unit="g/cm³" placeholder="0.0"
            bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.rho_wet}}" />
       </view>

       <view class="form-col">
          <block wx:if="{{!isPowerLaw}}">
             <ui-form-field label="有效粘度 η" fieldName="viscosity" data-field="viscosity" value="{{viscosity}}" unit="cP" placeholder="0.0"
                bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.viscosity}}" />
          </block>
          <block wx:else>
             <ui-form-field label="稠度系数 K" fieldName="K_val" data-field="K_val" value="{{K_val}}" unit="Pa·sⁿ" placeholder="0.0"
               bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.K_val}}" />
          </block>
       </view>
    </view>

    <!-- Row 2: Power Law Index (only if Power Law) -->
    <block wx:if="{{isPowerLaw}}">
      <view class="form-row" style="margin-bottom: 0;">
        <view class="form-col">
           <ui-form-field label="幂律指数 n" fieldName="n_val" data-field="n_val" value="{{n_val}}" placeholder="0.0"
             bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.n_val}}" />
        </view>
      </view>
    </block>

    <text wx:if="{{!isPowerLaw}}" class="hint-text" style="text-align:left; margin-top:4rpx; display:block; font-size: 20rpx; color: var(--text-sub);">* 牛顿流体：稠度系数K = 有效粘度η_eff = 旋转粘度计读数，幂律指数n=1</text>
  </ui-card>

  <!-- 工艺与几何参数 (Merged Card) -->
  <ui-card>
    <view class="section-title">工艺与几何参数 (Process)</view>

    <view class="form-group" style="margin-bottom: 24rpx;">
       <!-- Flex Layout for Input + Button -->
       <view class="input-row-with-actions" style="display:flex; align-items:flex-end; gap:12rpx;">
          <view style="flex:1">
             <!-- customStyle 用于覆盖组件内部的 margin-bottom -->
             <ui-form-field customStyle="margin-bottom:0;" label="系统总流量 Q" fieldName="pipe_Q" data-field="pipe_Q" value="{{pipe_Q}}" unit="L/min" placeholder="0.0"
               bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.pipe_Q}}" />
          </view>
          <!-- External Calc Button -->
          <view class="tool-btn" bindtap="openRPMModal" style="height:72rpx; width:72rpx; border:1px solid var(--border); border-radius:16rpx;">
             <ui-icon name="calc" size="40" color="var(--text-sub)" />
          </view>
       </view>
    </view>

    <!-- Divider -->
    <view class="divider" style="margin: 12rpx 0;"></view>

    <!-- 2. Split Columns (Pipe | Slot) -->
    <view class="split-layout">
      <!-- Left Column: Pipe -->
      <view class="split-col">
         <view class="subsection-title">供液管路</view>
         <view class="form-group">
            <ui-form-field label="管道内径 D" fieldName="pipe_D" data-field="pipe_D" value="{{pipe_D}}" unit="mm" placeholder="0.0"
              bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.pipe_D}}" />
         </view>
         <view class="form-group">
            <ui-form-field label="管道长度 L" fieldName="pipe_L" data-field="pipe_L" value="{{pipe_L}}" unit="m" placeholder="0.0"
              bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.pipe_L}}" />
         </view>
         <view class="form-group">
            <ui-form-field label="管路高差 Δz" fieldName="pipe_dz" data-field="pipe_dz" value="{{pipe_dz}}" unit="m" placeholder="0.0"
              bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.pipe_dz}}" />
         </view>
         <view class="form-group">
            <ui-form-field label="管路损耗系数 ΣK" fieldName="pipe_K_loss" data-field="pipe_K_loss" value="{{pipe_K_loss}}" placeholder="0.0"
              bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.pipe_K_loss}}">
              <view slot="right-icon" class="input-action" bindtap="openKModal" style="padding-left:12rpx; border-left:1px solid var(--border);">
                  <ui-icon name="list" size="32" color="var(--text-sub)" />
              </view>
            </ui-form-field>
         </view>

         <!-- Pipe Calc Button -->
         <view style="margin-top:auto; padding-top:12rpx;">
            <button class="btn-mini" bindtap="handleCalc" data-mode="pipe">计算管路</button>
         </view>
      </view>

      <!-- Vertical Divider -->
      <view class="v-divider" style="width:1px; background:var(--border); margin:0 8rpx;"></view>

      <!-- Right Column: Slot -->
      <view class="split-col">
         <view class="subsection-title">涂布模头</view>
         <view class="form-group">
            <ui-form-field label="垫片厚度 H" fieldName="slot_H" data-field="slot_H" value="{{slot_H}}" unit="µm" placeholder="0.0"
              bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.slot_H}}" />
         </view>
         <view class="form-group">
            <ui-form-field label="涂布幅宽 W" fieldName="slot_W" data-field="slot_W" value="{{slot_W}}" unit="mm" placeholder="0.0"
               bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.slot_W}}" />
         </view>
         <view class="form-group">
           <ui-form-field label="模唇陆长 Ls" fieldName="slot_Ls" data-field="slot_Ls" value="{{slot_Ls}}" unit="mm" placeholder="0.0"
             bind:input="onInput" bind:focus="onInputFocus" bind:blur="onInputBlur" isError="{{errors.slot_Ls}}" />
         </view>

         <!-- Slot Calc Button -->
         <view style="margin-top:auto; padding-top:12rpx;">
            <button class="btn-mini" bindtap="handleCalc" data-mode="slot">计算模头</button>
         </view>
      </view>
    </view>

    <view style="margin-top:24rpx;">
        <button class="btn btn-primary" style="width:100%;" bindtap="handleCalc" data-mode="total">计算全部</button>
    </view>
  </ui-card>

  <!-- Main Action (Standard Layout) -->


  <!-- Sticky Footer Action (Hidden) -->
  <view class="sticky-footer" style="display:none">
      <view class="footer-stack">
          <!-- V3 Result Bar (Stacked Above Button) -->
            <view class="result-summary-bar" wx:if="{{result.hasResult}}">
               <view class="rs-left">
                   <view class="rs-label">系统总压降 Total Pressure</view>
                   <view class="rs-val-row">
                       <block wx:if="{{result.total_dp.s}}">
                          <text class="rs-val">{{result.total_dp.b}}</text><text class="rs-times">×</text>10<text class="rs-sup">{{result.total_dp.pSup}}</text>
                       </block>
                       <block wx:else>
                          <text class="rs-val">{{result.total_dp.b}}</text>
                       </block>
                       <text class="rs-unit">kPa</text>
                   </view>
               </view>

               <!-- Integrated Ghost Action (Right Side) -->
               <view class="rs-right" bindtap="handleCalc" data-mode="total" hover-class="btn-hover-effect">
                  <view class="btn-recalc-ghost">
                      <text class="icon-refresh">🔄</text> 重算
                  </view>
               </view>
            </view>


      </view>
  </view>

  <ui-card class="result-card" wx:if="{{result.hasResult}}">
    <!-- Integrated Total Result (moved from footer) -->
    <view class="result-total-header">
        <text class="rt-label">系统总压降</text>
        <view class="rt-val-group">
            <block wx:if="{{result.total_dp.s}}">
                <text class="rt-val">{{result.total_dp.b}}</text><text class="rt-times">×</text><text class="sci-base">10{{result.total_dp.pSup}}</text>
            </block>
            <block wx:else>
                <text class="rt-val">{{result.total_dp.b}}</text>
            </block>
            <text class="rt-unit">kPa</text>
        </view>
    </view>
    <view class="h-divider" style="margin: 24rpx 0; border-bottom: 1px dashed rgba(255,255,255,0.1);"></view>

    <view class="warn-bar" wx:if="{{result.p_turb || result.s_turb}}">⚠️ 检测到湍流 (Re>2300)，压降参考价值较低</view>

    <!-- DUAL COLUMN LAYOUT -->
    <block wx:if="{{result.layoutMode === 'dual'}}">
       <view class="split-layout">
          <!-- PIPE COLUMN -->
          <view class="split-col">
             <text class="col-header">供液管路 (Pipe)</text>
             <view class="res-table">
                <!-- DP -->
                <view class="res-row">
                   <text class="res-label">压降 ΔP</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.p_dp.s}}">
                         <text class="sci-base">{{result.p_dp.b}}</text><text class="sci-times">×</text><text class="sci-base">10{{result.p_dp.pSup}}</text>
                      </block>
                      <block wx:else><text class="sci-base">{{result.p_dp.b}}</text></block>
                      <text class="unit">kPa</text>
                   </view>
                </view>
                <!-- Re -->
                <view class="res-row">
                   <text class="res-label">雷诺数 Re</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.p_re.s}}">
                         <text class="sci-base">{{result.p_re.b}}</text><text class="sci-times">×</text><text class="sci-base">10{{result.p_re.pSup}}</text>
                      </block>
                      <block wx:else><text class="sci-base">{{result.p_re.b}}</text></block>
                   </view>
                </view>
                <!-- Viscosity -->
                <view class="res-row">
                   <text class="res-label">有效粘度 η</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.p_visc.s}}">
                         <text class="sci-base">{{result.p_visc.b}}</text><text class="sci-times">×</text>
<text class="sci-base">10{{result.p_visc.pSup}}</text>
                      </block>
                      <block wx:else><text class="sci-base">{{result.p_visc.b}}</text></block>
                      <text class="unit">cP</text>
                   </view>
                </view>
                <!-- Shear Rate -->
                <view class="res-row">
                   <text class="res-label">剪切速率 γ̇</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.p_shear.s}}">
                         <text class="sci-base">{{result.p_shear.b}}</text><text class="sci-times">×</text>
<text class="sci-base">10{{result.p_shear.pSup}}</text>
                      </block>
                      <block wx:else><text class="sci-base">{{result.p_shear.b}}</text></block>
                      <text class="unit">s⁻¹</text>
                   </view>
                </view>
             </view>
          </view>

          <!-- VERTICAL DIVIDER -->
          <view class="v-divider"></view>

          <!-- SLOT COLUMN -->
          <view class="split-col">
             <text class="col-header">狭缝模头 (Slot)</text>
             <view class="res-table">
                <!-- DP -->
                <view class="res-row">
                   <text class="res-label">压降 ΔP</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.s_dp.s}}">
                         <text class="sci-base">{{result.s_dp.b}}</text><text class="sci-times">×</text>
<text class="sci-base">10{{result.s_dp.pSup}}</text>
                      </block>
                      <block wx:else><text class="sci-base">{{result.s_dp.b}}</text></block>
                      <text class="unit">kPa</text>
                   </view>
                </view>
                <!-- Re -->
                <view class="res-row">
                   <text class="res-label">雷诺数 Re</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.s_re.s}}">
                         <text class="sci-base">{{result.s_re.b}}</text><text class="sci-times">×</text>
<text class="sci-base">10{{result.s_re.pSup}}</text>
                      </block>
                      <block wx:else><text class="sci-base">{{result.s_re.b}}</text></block>
                   </view>
                </view>
                <!-- Viscosity -->
                <view class="res-row">
                   <text class="res-label">有效粘度 η</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.s_visc.s}}">
                         <text class="sci-base">{{result.s_visc.b}}</text><text class="sci-times">×</text>
<text class="sci-base">10{{result.s_visc.pSup}}</text>
                      </block>
                      <block wx:else><text class="sci-base">{{result.s_visc.b}}</text></block>
                      <text class="unit">cP</text>
                   </view>
                </view>
                <!-- Shear Rate -->
                <view class="res-row">
                   <text class="res-label">剪切速率 γ̇</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.s_shear.s}}">
                         <text class="sci-base">{{result.s_shear.b}}</text><text class="sci-times">×</text>
<text class="sci-base">10{{result.s_shear.pSup}}</text>
                      </block>
                      <block wx:else><text class="sci-base">{{result.s_shear.b}}</text></block>
                      <text class="unit">s⁻¹</text>
                   </view>
                </view>
             </view>
          </view>
       </view>
    </block>

    <block wx:else>
       <!-- SINGLE MODE CENTERED -->
       <view class="split-layout single-centered">
          <view class="split-col">
             <text class="col-header">{{result.layoutMode === 'single-pipe' ? '供液管路 (Pipe)' : '狭缝模头 (Slot)'}}</text>
             <view class="res-table">
                <!-- DP -->
                <view class="res-row">
                   <text class="res-label">压降 ΔP</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.layoutMode === 'single-pipe' ? result.p_dp.s : result.s_dp.s}}">
                         <text class="sci-base">{{result.layoutMode === 'single-pipe' ? result.p_dp.b : result.s_dp.b}}</text>
                         <text class="sci-times">×</text>
<text class="sci-base">10{{result.layoutMode === 'single-pipe' ? result.p_dp.pSup : result.s_dp.pSup}}</text>
                      </block>
                      <block wx:else>
                         <text class="sci-base">{{result.layoutMode === 'single-pipe' ? result.p_dp.b : result.s_dp.b}}</text>
                      </block>
                      <text class="unit">kPa</text>
                   </view>
                </view>
                 <!-- Re -->
                <view class="res-row">
                   <text class="res-label">雷诺数 Re</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.layoutMode === 'single-pipe' ? result.p_re.s : result.s_re.s}}">
                         <text class="sci-base">{{result.layoutMode === 'single-pipe' ? result.p_re.b : result.s_re.b}}</text>
                         <text class="sci-times">×</text>
<text class="sci-base">10{{result.layoutMode === 'single-pipe' ? result.p_re.pSup : result.s_re.pSup}}</text>
                      </block>
                      <block wx:else>
                         <text class="sci-base">{{result.layoutMode === 'single-pipe' ? result.p_re.b : result.s_re.b}}</text>
                      </block>
                   </view>
                </view>
                 <!-- Viscosity -->
                <view class="res-row">
                   <text class="res-label">有效粘度 η</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.layoutMode === 'single-pipe' ? result.p_visc.s : result.s_visc.s}}">
                         <text class="sci-base">{{result.layoutMode === 'single-pipe' ? result.p_visc.b : result.s_visc.b}}</text>
                         <text class="sci-times">×</text>
<text class="sci-base">10{{result.layoutMode === 'single-pipe' ? result.p_visc.pSup : result.s_visc.pSup}}</text>
                      </block>
                      <block wx:else>
                         <text class="sci-base">{{result.layoutMode === 'single-pipe' ? result.p_visc.b : result.s_visc.b}}</text>
                      </block>
                      <text class="unit">cP</text>
                   </view>
                </view>
                 <!-- Shear -->
                <view class="res-row">
                   <text class="res-label">剪切速率 γ̇</text>
                   <view class="res-val-group">
                      <block wx:if="{{result.layoutMode === 'single-pipe' ? result.p_shear.s : result.s_shear.s}}">
                         <text class="sci-base">{{result.layoutMode === 'single-pipe' ? result.p_shear.b : result.s_shear.b}}</text>
                         <text class="sci-times">×</text>
<text class="sci-base">10{{result.layoutMode === 'single-pipe' ? result.p_shear.pSup : result.s_shear.pSup}}</text>
                      </block>
                      <block wx:else>
                         <text class="sci-base">{{result.layoutMode === 'single-pipe' ? result.p_shear.b : result.s_shear.b}}</text>
                      </block>
                      <text class="unit">s⁻¹</text>
                   </view>
                </view>
             </view>
          </view>
       </view>
    </block>

  </ui-card>

  <!-- 计算原理说明弹窗 (Restored) -->
  <view class="modal-mask center-modal" wx:if="{{showFormula}}">
    <view class="fm-card dark-theme-fix">
      <view class="fm-head">
        <view class="fm-title highlight">计算原理</view>
        <view class="close-icon" bindtap="toggleFormula">×</view>
      </view>
      <scroll-view scroll-y class="fm-scroll">
        <view class="f-box">
          <view class="ft">1. 幂律模型 (Power Law)</view>
          <view class="fm-row">η_eff = K·(γ_wall)<text class="sup">n-1</text></view>
          <view class="legend-grid">
            <view><text>K</text> 稠度系数 (Pa·sⁿ)</view>
            <view><text>n</text> 幂律指数 (无)</view>
            <view><text>γ_wall</text> 壁面剪切速率 (s⁻¹)</view>
          </view>
        </view>
        <view class="f-box">
          <view class="ft">2. 圆管压降 (Pipe ΔP)</view>
          <view class="fm-row"><text>ΔP = </text>
            <view class="frac">
              <view class="n">128·η_eff·L·Q</view>
              <view class="d">π·D⁴</view>
            </view><text> + ρgΔz + ΣK·</text>
            <view class="frac">
              <view class="n">ρv²</view>
              <view class="d">2</view>
            </view>
          </view>
          <view class="fm-row-split">
            <view class="fm-item"><text>γ_wall = </text>
              <view class="frac">
                <view class="n">3n+1</view>
                <view class="d">4n</view>
              </view><text> · </text>
              <view class="frac">
                <view class="n">32·Q</view>
                <view class="d">π·D³</view>
              </view>
            </view>
            <view class="fm-item"><text>v = </text>
              <view class="frac">
                <view class="n">4·Q</view>
                <view class="d">π·D²</view>
              </view>
            </view>
          </view>
          <view class="legend-grid">
            <view><text>D</text> 管道内径 (m)</view>
            <view><text>L</text> 管道长度 (m)</view>
            <view><text>Q</text> 流量 (m³/s)</view>
            <view><text>v</text> 流速 (m/s)</view>
            <view><text>ρ</text> 湿胶密度 (kg/m³)</view>
            <view><text>Δz</text> 高程差 (m)</view>
          </view>
        </view>
        <view class="f-box">
          <view class="ft">3. 狭缝压降 (Slot ΔP)</view>
          <view class="fm-row"><text>ΔP = </text>
            <view class="frac">
              <view class="n">12·η_eff·Ls·Q</view>
              <view class="d">W·H³</view>
            </view>
          </view>
          <view class="fm-row-split">
            <view class="fm-item"><text>γ_wall = </text>
              <view class="frac">
                <view class="n">2n+1</view>
                <view class="d">3n</view>
              </view><text> · </text>
              <view class="frac">
                <view class="n">6·Q</view>
                <view class="d">W·H²</view>
              </view>
            </view>
            <view class="fm-item"><text>v = </text>
              <view class="frac">
                <view class="n">Q</view>
                <view class="d">W·H</view>
              </view>
            </view>
          </view>
          <view class="legend-grid">
            <view><text>Ls</text> 模唇陆长 (m)</view>
            <view><text>H</text> 垫片厚度 (m)</view>
            <view><text>W</text> 涂布幅宽 (m)</view>
            <view><text>v</text> 流速 (m/s)</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 流量换算弹窗 - 蓝色主题 -->
  <view class="modal-mask" wx:if="{{showRPMModal}}" bindtap="closeRPMModal">
    <view class="modal-card conv-modal fluid" catchtap="preventBubble">
      <!-- 标题栏 -->
      <view class="conv-head">
        <text class="conv-title">泵转速 → 流量 换算</text>
        <view class="close-icon" bindtap="closeRPMModal">×</view>
      </view>

      <!-- 公式展示 -->
      <view class="conv-formula-box">
        <text class="formula-label">计算公式</text>
        <view class="formula-code">Q = Dp × N / 1000</view>
      </view>

      <!-- 输入区域 -->
      <view class="conv-inputs">
        <view class="conv-input-col">
          <text class="conv-label">Dp 泵排量</text>
          <view class="input-native-wrapper fluid {{focus.rpm_dp ? 'focused' : ''}}">
            <input class="native-input" type="digit"
              bindinput="onRPMInput" bindfocus="onRPMFocus" bindblur="onRPMBlur"
              data-field="temp_disp" value="{{temp_disp}}" placeholder="0.0" />
            <view class="unit-suffix-native">cc/rev</view>
          </view>
        </view>
        <view class="conv-input-col">
          <text class="conv-label">N 转速</text>
          <view class="input-native-wrapper fluid {{focus.rpm_n ? 'focused' : ''}}">
            <input class="native-input" type="digit"
              bindinput="onRPMInput" bindfocus="onRPMFocus" bindblur="onRPMBlur"
              data-field="temp_rpm" value="{{temp_rpm}}" placeholder="0.0" />
            <view class="unit-suffix-native">rpm</view>
          </view>
        </view>
      </view>

      <!-- 计算结果 -->
      <view class="conv-result-box" wx:if="{{rpmResult}}">
        <text class="conv-result-label">计算结果</text>
        <view class="conv-result-value">
          <text class="conv-result-num">{{rpmResult}}</text>
          <text class="conv-result-unit">L/min</text>
        </view>
      </view>

      <!-- 底部按钮 -->
      <view class="conv-foot">
        <button class="btn-ghost" bindtap="closeRPMModal">取消</button>
        <button class="btn-primary" bindtap="applyRPMResult" wx:if="{{rpmResult}}">应用到表单</button>
      </view>
    </view>
  </view>

  <view class="modal-mask center-modal" wx:if="{{showKModal}}" bindtap="closeKModal">
    <view class="modal-card k-card dark-theme-fix" catchtap="preventBubble">
      <view class="mc-head highlight">
        <text>常用损耗系数 K</text>
        <view class="close-icon" bindtap="closeKModal">×</view>
      </view>
      <scroll-view scroll-y class="k-list">
        <view class="k-item" bindtap="addKFactor" data-k="0.75">
          <view class="ki-icon">⤵️</view>
          <view class="ki-info">
            <text class="ki-name">90° 弯头</text>
            <text class="ki-sub">Standard Elbow</text>
          </view>
          <view class="ki-right">
            <text class="ki-val">0.75</text>
            <view class="ki-add">+</view>
          </view>
        </view>

        <view class="k-item" bindtap="addKFactor" data-k="1.5">
          <view class="ki-icon">🔀</view>
          <view class="ki-info">
            <text class="ki-name">标准三通</text>
            <text class="ki-sub">Standard Tee</text>
          </view>
          <view class="ki-right">
            <text class="ki-val">1.50</text>
            <view class="ki-add">+</view>
          </view>
        </view>

        <view class="k-item" bindtap="addKFactor" data-k="0.1">
          <view class="ki-icon">⚪</view>
          <view class="ki-info">
            <text class="ki-name">全开球阀</text>
            <text class="ki-sub">Ball Valve (Full)</text>
          </view>
          <view class="ki-right">
            <text class="ki-val">0.10</text>
            <view class="ki-add">+</view>
          </view>
        </view>

        <view class="k-item" bindtap="addKFactor" data-k="5.0">
          <view class="ki-icon">🕸️</view>
          <view class="ki-info">
            <text class="ki-name">过滤器</text>
            <text class="ki-sub">Strainer / Filter</text>
          </view>
          <view class="ki-right">
            <text class="ki-val">5.00</text>
            <view class="ki-add">+</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="modal-mask center-modal" wx:if="{{showFormula}}">
    <view class="fm-card dark-theme-fix">
      <view class="fm-head">
        <view class="fm-title highlight">计算原理</view>
        <view class="close-icon" bindtap="toggleFormula">×</view>
      </view>
      <scroll-view scroll-y class="fm-scroll">
        <view class="f-box">
          <view class="ft">1. 幂律模型 (Power Law)</view>
          <view class="fm-row">η_eff = K·(γ_wall)<text class="sup">n-1</text></view>
          <view class="legend-grid">
            <view><text>K</text> 稠度系数 (Pa·sⁿ)</view>
            <view><text>n</text> 幂律指数 (无)</view>
            <view><text>γ_wall</text> 壁面剪切速率 (s⁻¹)</view>
          </view>
        </view>
        <view class="f-box">
          <view class="ft">2. 圆管压降 (Pipe ΔP)</view>
          <view class="fm-row"><text>ΔP = </text>
            <view class="frac">
              <view class="n">128·η_eff·L·Q</view>
              <view class="d">π·D⁴</view>
            </view><text> + ρgΔz + ΣK·</text>
            <view class="frac">
              <view class="n">ρv²</view>
              <view class="d">2</view>
            </view>
          </view>
          <view class="fm-row-split">
            <view class="fm-item"><text>γ_wall = </text>
              <view class="frac">
                <view class="n">3n+1</view>
                <view class="d">4n</view>
              </view><text> · </text>
              <view class="frac">
                <view class="n">32·Q</view>
                <view class="d">π·D³</view>
              </view>
            </view>
            <view class="fm-item"><text>v = </text>
              <view class="frac">
                <view class="n">4·Q</view>
                <view class="d">π·D²</view>
              </view>
            </view>
          </view>
          <view class="legend-grid">
            <view><text>D</text> 管道内径 (m)</view>
            <view><text>L</text> 管道长度 (m)</view>
            <view><text>Q</text> 流量 (m³/s)</view>
            <view><text>v</text> 流速 (m/s)</view>
            <view><text>ρ</text> 湿胶密度 (kg/m³)</view>
            <view><text>Δz</text> 高程差 (m)</view>
          </view>
        </view>
        <view class="f-box">
          <view class="ft">3. 狭缝压降 (Slot ΔP)</view>
          <view class="fm-row"><text>ΔP = </text>
            <view class="frac">
              <view class="n">12·η_eff·Ls·Q</view>
              <view class="d">W·H³</view>
            </view>
          </view>
          <view class="fm-row-split">
            <view class="fm-item"><text>γ_wall = </text>
              <view class="frac">
                <view class="n">2n+1</view>
                <view class="d">3n</view>
              </view><text> · </text>
              <view class="frac">
                <view class="n">6·Q</view>
                <view class="d">W·H²</view>
              </view>
            </view>
            <view class="fm-item"><text>v = </text>
              <view class="frac">
                <view class="n">Q</view>
                <view class="d">W·H</view>
              </view>
            </view>
          </view>
          <view class="legend-grid">
            <view><text>Ls</text> 模唇陆长 (m)</view>
            <view><text>H</text> 垫片厚度 (m)</view>
            <view><text>W</text> 涂布幅宽 (m)</view>
            <view><text>v</text> 流速 (m/s)</view>
          </view>
        </view>
      </scroll-view>
      <!-- Removed bottom close button -->
    </view>
  </view>

  <confirm-modal show="{{showResetModal}}" title="清空确认" content="确定要清空当前页面的所有输入数据吗？此操作无法撤销。" confirmDanger="{{true}}"
    bind:cancel="cancelReset" bind:confirm="execReset" />

  <!-- 历史记录弹窗 -->
  <view class="modal-mask" wx:if="{{showHistoryModal}}" bindtap="closeHistoryModal">
    <view class="modal-card history-card" catchtap="preventBubble">
      <view class="mc-head">历史记录</view>
      <scroll-view scroll-y class="history-scroll">
        <block wx:if="{{localHistory.length > 0}}">
          <view class="history-item" wx:for="{{localHistory}}" wx:key="id" bindtap="restoreHistory"
            data-index="{{index}}">
            <view class="hi-del-btn" catchtap="deleteHistoryItem" data-id="{{item.id}}">×</view>
            <view class="hi-time">{{item.time}}</view>
            <view class="hi-data">
              <view class="hi-row" wx:for="{{item.data}}" wx:key="k" wx:for-item="sub">
                <text class="hi-k">{{sub.k}}</text>
                <text class="hi-v">{{sub.v}}</text>
              </view>
            </view>
          </view>
        </block>
        <view class="empty-hint" wx:else>暂无历史记录</view>
      </scroll-view>
      <view class="mc-foot">
        <button class="btn-ghost" bindtap="closeHistoryModal">关闭</button>
      </view>
    </view>
  </view>

  <confirm-modal show="{{showDeleteModal}}" title="删除确认" content="确定要删除这条记录吗？" confirmDanger="{{true}}"
    bind:confirm="confirmDelete" bind:cancel="cancelDelete" />
</view>