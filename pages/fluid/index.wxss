@import "../../styles/form.wxss";
@import "../../styles/icon.wxss";

/* Fluid Layout & Theme - Matching Coating Module */
page {
  font-family: "DIN Alternate", "Roboto", Helvetica, sans-serif;
  box-sizing: border-box;
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg);
  color: var(--text);
  padding: 0;
  padding-bottom: 320rpx; /* Ensure content isn't hidden behind footer */
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* 导航栏样式 - 沉浸式 */
.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg);
  box-sizing: border-box;
}

.nav-row {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.toolbar-row {
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 24rpx;
  gap: 40rpx;
  background: transparent;
  margin-bottom: 4rpx;
  box-sizing: border-box;
}

.back-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-sub);
  margin-right: 4rpx;
  flex-shrink: 0;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx;
  background: transparent !important;
  border: none !important;
  border-radius: 8rpx;
}

.tool-hover {
  opacity: 0.6;
  transform: scale(0.95);
}

.tool-btn .icon {
  font-size: 30rpx;
  opacity: 0.7;
  color: var(--text-main);
  line-height: 1;
}

.tool-btn .icon:active {
  opacity: 1;
}

/* Panel Layout */
.panel {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Section & Titles - Level 1 (H1) */
.section-title, .sec-title {
  font-size: 30rpx; /* Balanced Main Title */
  font-weight: 700;
  color: var(--primary);
  margin: 20rpx 0 16rpx 0;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--primary);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

/* Subsection Titles - Level 2 (H2) */
.subsection-title {
  font-size: 28rpx; /* Distinctly larger than labels (24rpx) */
  font-weight: 700; /* Bold for hierarchy */
  color: var(--text-main); /* White/Bright to stand out */
  margin: 12rpx 0 8rpx 0;
  padding-left: 8rpx;
  opacity: 0.9;
  display: flex;
  align-items: center;
}

.subsection-title::before {
  content: '';
  display: block;
  width: 6rpx;
  height: 24rpx;
  background: var(--accent); /* Blue accent for subsections */
  margin-right: 12rpx;
  border-radius: 2rpx;
}

/* Sticky Footer */
.sticky-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #111827; /* Hardcoded opaque dark for safety, avoids var issues */
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 999; /* Higher z-index */
  border-top: 1px solid var(--border);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.5); /* Stronger shadow */
  display: flex;
  justify-content: center; /* Center the button */
}

.sticky-footer .btn {
  width: 90%; /* Not full width, better centered look */
  max-width: 600rpx;
}

.sticky-footer .btn {
  width: 90%; /* Not full width, better centered look */
  max-width: 600rpx;
}

/* Mini Buttons */
/* V13 Mini Button - Subtle Professional */
.btn-mini {
  background: rgba(59, 130, 246, 0.1); /* Subtle Blue Text */
  color: #3b82f6;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  border: none;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.btn-outline {
  /* Deprecated - merged into btn-mini */
  display: none;
}

/* Extreme Compact Form Layouts */
.form-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 6rpx; /* Tighter */
}

.form-group {
  margin-bottom: 6rpx; /* Tighter */
}

.form-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.divider {
  height: 1px;
  background: var(--border);
  margin: 10rpx 0; /* Tighter */
  opacity: 0.5;
}

.hint-text {
  font-size: 22rpx;
  color: var(--text-sub);
  opacity: 0.8;
  margin-top: 4rpx;
  line-height: 1.4;
}

/* Result Card Styles - Professional Table */
/* .res-action-bar removed */

/* Result Card Styles - V2 Redesign (Premium Minimalist) */

/* Layout Containers */
.split-layout {
  display: flex;
  justify-content: space-between;
  position: relative;
  padding: 8rpx 0;
}

/* Result Card Styles - V5 Titanium & Glass */

/* Layout Containers */
.split-layout {
  display: flex;
  gap: 20rpx; /* REVERT TO COMPACT */
  padding: 0;
}

.split-layout.single-centered {
  width: 100%;
  justify-content: stretch;
}

/* Glass Cards */
.split-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(128, 128, 128, 0.05); /* Neutral Transparent */
  border: 1px solid rgba(128, 128, 128, 0.1);
  border-radius: 16rpx;
  padding: 24rpx; /* REVERT TO COMPACT */
  min-width: 0;
}

.v-divider { display: none; }

/* Headers - Visual Hierarchy (Capsule Style) */
.col-header {
  font-size: 24rpx;
  font-weight: 700;
  color: #94a3b8; /* Slate-400 (Neutral) */
  text-transform: uppercase;
  letter-spacing: 1.5rpx;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 8rpx 24rpx;
  background: rgba(148, 163, 184, 0.1); /* Neutral Bg */
  border: 1px solid rgba(148, 163, 184, 0.2); /* Neutral Border */
  border-radius: 100rpx;
  align-self: center;
  display: inline-block;
}

/* New Total Result Header */
.result-total-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0; /* COMPACT HEADER */
  margin-bottom: 24rpx;
}

.rt-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #3b82f6; /* Blue-500 */
}

.rt-val-group {
  display: flex;
  align-items: baseline;
}

.rt-val {
  font-size: 48rpx;
  font-weight: 800;
  color: #3b82f6;
  font-family: ui-monospace, SFMono-Regular, "DIN Alternate", monospace;
  font-variant-numeric: tabular-nums;
}

.rt-times { margin: 0 4rpx; font-size: 32rpx; color: #3b82f6; opacity: 0.8; }
.rt-sup { font-size: 24rpx; vertical-align: super; top: -12rpx; position:relative; color: #3b82f6; font-weight: 600; }
.rt-unit { font-size: 24rpx; color: #64748b; margin-left: 12rpx; font-weight:600; align-self: flex-end; padding-bottom: 6rpx; }

/* Data Grid */
.res-table {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.res-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 0;
  border-bottom: none;
}

.res-label {
  font-size: 26rpx;
  color: #64748b; /* Slate-500 (Context) */
  font-weight: 500;
  flex: 1;
  white-space: nowrap; /* NO WRAPPING */
  overflow: visible; /* Allow spill if needed, or hidden with ellipsis? User wants single line. Visible is safer for now or min-width. */
  margin-right: 16rpx;
}

.res-val-group {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
  color: #fff;
  text-align: right;
  flex: 1; /* Allow growing */
  min-width: 0; /* Allow shrinking if needed (though we want unit to stay) */
  display: flex; /* Ensure internal flex behavior */
  justify-content: flex-end;
}

/* Scientific Notation */
/* Scientific Notation */
.sci-base, .sci-val {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: #3b82f6; /* Blue-500 (Primary Brand Color) */
}

.sci-times {
  margin: 0 4rpx;
  font-size: 26rpx;
  color: #3b82f6; /* Blue (Unify with Base) */
  opacity: 0.8;
}

.sup {
  font-size: 20rpx;
  vertical-align: super;
  margin-left: 1rpx;
  font-weight: 600;
  color: #3b82f6; /* Blue (Unify with Base) */
  position: relative;
  top: -8rpx;
  opacity: 0.9;
}

.unit {
  font-size: 22rpx;
  color: #94a3b8; /* Slate-400 */
  margin-left: 6rpx; /* Reduced margin */
  font-weight: 500;
  align-self: flex-end;
  padding-bottom: 4rpx;
  flex-shrink: 0; /* Prevent shrinking */
  white-space: nowrap;
}

/* V5 Ghost Button - Clean & Transparent */
.btn-recalc-ghost {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  border: 1px solid rgba(255,255,255,0.15);
  backdrop-filter: blur(4px);
  transition: all 0.2s;
}

.btn-hover-effect .btn-recalc-ghost {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.98);
}


/* V3 Stacked Footer - Professional Dashboard */
.sticky-footer {
  display: none !important;
  flex-direction: column !important;
  justify-content: flex-end; /* Align to bottom */
  align-items: center;
  gap: 16rpx;
}

.footer-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

/* 1. Result Summary Bar (Horizontal Integated Layout) */
.result-summary-bar {
  width: 96%;
  background: rgba(30, 64, 175, 0.4); /* Indigo-900 with opacity */
  border: 1px solid rgba(59, 130, 246, 0.4); /* Blue-500 border */
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  display: flex;
  flex-direction: row; /* Horizontal Layout */
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(10px);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.rs-left {
  display: flex;
  flex-direction: column;
}



.icon-refresh {
  margin-right: 8rpx;
  font-size: 24rpx;
}
/* End of V2 Redesign */
