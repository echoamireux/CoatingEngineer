/* pages/admin/index.wxss */
/* 继承全局变量 */
page {
  background: var(--bg, #f3f4f6);
  color: var(--text, #1f2937);
  font-family: -apple-system, sans-serif;
}

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 沉浸式导航栏 */
.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg); /* 沉浸式背景 */
  box-sizing: border-box;
}

.nav-row {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}

.back-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-sub, #6b7280);
  font-weight: 300;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text, #1f2937);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

/* 内容区域 */
.content-body {
  padding: 32rpx;
  flex: 1;
}

/* 卡片样式 */
.card {
  background: var(--card, #fff);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
  border: 1px solid var(--border, transparent);
}

.section-title {
  font-size: 28rpx;
  color: var(--text-sub, #6b7280);
  margin-bottom: 16rpx;
  margin-left: 8rpx;
  font-weight: 500;
}

/* 表单项 */
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  color: var(--text);
}

.divider {
  height: 1rpx;
  background: var(--border, #e5e7eb);
  margin: 24rpx 0;
}

.input-row {
  display: flex;
  width: 100%;
  gap: 16rpx;
}

.input-box {
  flex: 1;
  background: var(--bg, #f9fafb);
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--text);
}

/* 按钮 */
.btn-mini {
  background: var(--accent, #3b82f6);
  color: white;
  padding: 0 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #10b981;
  color: white;
  width: 100%;
  margin-top: 32rpx;
  border-radius: 16rpx;
  font-weight: bold;
}

.btn-secondary {
  background: var(--card, #fff);
  color: #3b82f6;
  border: 1px solid #3b82f6;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
}

.btn-logout {
  background: transparent;
  color: #ef4444;
  font-size: 28rpx;
}

.footer-action {
  margin-top: 64rpx;
}

/* 登录面板 */
.login-panel {
  margin-top: 100rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 48rpx;
  color: var(--text);
}

.login-input {
  background: var(--bg, #f9fafb);
  border: 1px solid var(--border, #e5e7eb);
  height: 96rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
  text-align: center;
  color: var(--text);
}
