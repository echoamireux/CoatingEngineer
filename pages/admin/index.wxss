/* pages/admin/index.wxss */
page {
  background: #f3f4f6;
  color: #1f2937;
  padding-bottom: 40rpx;
}

.container {
  padding: 32rpx;
}

.header {
  margin-bottom: 48rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #6b7280;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 6rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
  margin-left: 8rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.divider {
  height: 1rpx;
  background: #e5e7eb;
  margin: 24rpx 0;
}

.input-row {
  display: flex;
  width: 100%;
  gap: 16rpx;
}

.input-box {
  flex: 1;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
}

/* 按钮 */
.btn-mini {
  background: #3b82f6;
  color: white;
  padding: 0 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #10b981;
  color: white;
  width: 100%;
  margin-top: 32rpx;
}

.btn-secondary {
  background: #fff;
  color: #3b82f6;
  border: 1px solid #3b82f6;
  margin-bottom: 24rpx;
}

.btn-logout {
  background: transparent;
  color: #ef4444;
  font-size: 28rpx;
}

.footer-action {
  margin-top: 64rpx;
}

/* 登录面板 */
.login-panel {
  margin-top: 100rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 48rpx;
}

.login-input {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  height: 96rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
  text-align: center;
}
