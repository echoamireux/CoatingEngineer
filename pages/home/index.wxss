/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding: 30rpx;
  box-sizing: border-box;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
}

/* 主题变量 */
.page-container.dark {
  --bg: #111827;
  --card: #1f2937;
  --text: #e5e7eb;
  --text-sub: #9ca3af;
  --primary: #10b981;
  --border: #374151;
  --title-shadow: 0 4rpx 8rpx rgba(0,0,0,0.5);
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.4); 
  --input-bg: rgba(255,255,255,0.05); 
  --primary-btn-shadow: 0 8rpx 16rpx rgba(16, 185, 129, 0.3); 
}
.page-container.light {
  --bg: #f3f4f6;
  --card: #ffffff;
  --text: #1f2937;
  --text-sub: #6b7280;
  --primary: #059669;
  --border: #e5e7eb;
  --title-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.1); 
  --input-bg: rgba(0,0,0,0.03);
  --primary-btn-shadow: 0 8rpx 16rpx rgba(5, 150, 105, 0.25);
}

/* 头部 */
.home-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0; 
  padding: 10rpx 0;
}

.header-placeholder, .theme-toggle {
  width: 72rpx;
  height: 72rpx;
}

.theme-toggle {
  font-size: 40rpx;
  background: var(--card);
  border-radius: 50%;
  border: 1px solid var(--border);
  text-align: center;
  line-height: 72rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

/* 标题区域 */
.title-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 10rpx;
}

.app-name {
  font-size: 56rpx; 
  font-weight: 900;
  letter-spacing: 4rpx;
  line-height: 1.2;
  text-shadow: var(--title-shadow);
  font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif;
}

.app-sub {
  font-size: 20rpx;
  color: var(--primary); 
  letter-spacing: 12rpx;
  font-weight: bold;
  opacity: 0.9;
  margin-top: 12rpx;
  text-transform: uppercase; 
  font-family: "DIN Alternate", Helvetica, sans-serif;
}

/* 内容布局 - ★★★ 调整点 1 ★★★ */
.content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  /* 之前是 40rpx，现在改为 70rpx，让列表稍微下沉一点，不撞头 */
  padding-top: 70rpx; 
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.menu-card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 0;
  display: flex;
  align-items: stretch;
  border: 1px solid var(--border);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease;
}
.menu-card:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.card-bar { width: 12rpx; }

.card-content {
  flex: 1;
  padding: 32rpx 24rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.card-icon { font-size: 38rpx; }

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  padding-left: 2rpx;
  opacity: 0.7;
  font-weight: 300;
}

.card-arrow {
  width: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-sub);
  opacity: 0.3;
}

/* ★★★ 底部辅助功能区 - ★★★ 调整点 2 ★★★ */
.support-area {
  /* 之前是 80rpx，现在改为 40rpx，拉近与上面列表的距离 */
  margin-top: 40rpx; 
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0; 
}

.support-btn {
  flex: 1; 
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.2s;
  opacity: 0.6;
}

.support-btn:active {
  opacity: 1;
  background: var(--input-bg);
  border-radius: 16rpx;
}

.sup-icon { 
  font-size: 32rpx; 
}

.sup-text {
  font-size: 26rpx;
  color: var(--text-sub); 
  font-weight: 500;
}

.sup-divider {
  width: 1px;
  height: 30rpx;
  background: var(--text-sub);
  opacity: 0.2;
}

/* 按钮重置 */
.btn-reset {
  margin: 0;
  line-height: inherit;
  box-sizing: border-box;
  color: inherit;
  font-weight: normal;
  overflow: hidden;
}
.btn-reset::after { border: none; }

/* 页脚 */
.footer {
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  opacity: 0.25;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  margin-top: auto;
}
.copyright { 
  font-size: 20rpx; 
  font-weight: bold; 
  font-family: "DIN Alternate", sans-serif;
  letter-spacing: 1rpx;
}
.slogan { font-size: 18rpx; font-style: italic; }

/* 弹窗样式 */
.modal-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px);
  z-index: 999;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: all 0.3s ease;
}
.modal-mask.show { opacity: 1; pointer-events: auto; }
.modal-mask.show .modal-card { transform: translateY(0) scale(1); opacity: 1; }

.modal-card {
  width: 80%; 
  background: var(--card);
  border-radius: 32rpx; 
  padding: 40rpx; 
  text-align: center;
  box-shadow: var(--modal-shadow); 
  border: 1px solid var(--border);
  transform: translateY(20rpx) scale(0.95);
  opacity: 0; transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.mc-header {
  display: flex; flex-direction: column; align-items: center;
  margin-bottom: 30rpx;
}
.mc-icon-badge {
  font-size: 64rpx; margin-bottom: 20rpx;
  width: 100rpx; height: 100rpx;
  background: var(--input-bg);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.mc-title {
  font-size: 38rpx; font-weight: 900; color: var(--text);
  letter-spacing: 1rpx;
}

.mc-body { margin-bottom: 50rpx; }
.mc-desc {
  font-size: 28rpx; color: var(--text-sub);
  line-height: 1.6;
  white-space: pre-wrap;
  display: block;
  opacity: 0.9;
}

.login-input-wrapper {
  margin-top: 40rpx;
  padding: 0 10rpx;
}
.login-inp-pro {
  height: 96rpx;
  background: var(--input-bg);
  border: 1px solid transparent; 
  border-radius: 16rpx;
  color: var(--text);
  font-size: 40rpx; 
  text-align: center;
  letter-spacing: 12rpx; 
  font-weight: bold;
  font-family: "DIN Alternate", monospace;
  transition: all 0.2s;
}
.login-inp-pro:focus {
  border-color: var(--primary);
  background: var(--bg);
}
.ph-style-pro {
  color: var(--text-sub);
  font-size: 28rpx;
  font-weight: normal;
  letter-spacing: 2rpx;
  opacity: 0.5;
}

.mc-footer { display: flex; gap: 24rpx; }
.btn-pro {
  flex: 1;
  font-size: 30rpx; font-weight: bold;
  height: 96rpx; line-height: 96rpx;
  border-radius: 20rpx; 
  border: none;
  transition: all 0.2s;
}
.btn-pro:active { transform: scale(0.98); }

.btn-cancel {
  background: transparent; 
  color: var(--text-sub);
  border: 1px solid var(--border); 
}
.btn-confirm {
  background: var(--primary);
  color: #fff;
  box-shadow: var(--primary-btn-shadow); 
}

/* ★★★ 新增：口令提示小字 ★★★ */
.hint-text {
  margin-top: 24rpx; /* 离输入框有一点距离 */
  font-size: 22rpx;  /* 字体要很小 */
  color: var(--text-sub); /* 用次级灰色 */
  opacity: 0.5; /* 增加透明度，让它看起来更不显眼 */
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: -apple-system, sans-serif;
}