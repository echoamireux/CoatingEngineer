/* 页面容器 */
.page-container {
  /* 沉浸式适配：增加状态栏高度 */
  padding-top: env(safe-area-inset-top);
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding: 0 30rpx;
  box-sizing: border-box;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
}

/* Home专属变量 - 暗黑模式 */
.page-container.dark {
  /* 基础变量继承全局，只定义Home专属 */
  --title-shadow: 0 4rpx 8rpx rgba(0,0,0,0.5);
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.5);
  --input-bg: rgba(255,255,255,0.05);

  /* 关于弹窗配色 */
  --about-title: #ffffff;
  --about-tag: #e5e7eb;
  --about-text: #9ca3af;

  /* 打赏按钮 */
  --reward-bg: #2d2a26;
  --reward-border: #d4af37;
  --reward-text: #d4af37;
}

/* Home专属变量 - 白天模式 */
.page-container.light {
  --title-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.1);
  --input-bg: rgba(0,0,0,0.03);

  /* 关于弹窗配色 */
  --about-title: #111827;
  --about-tag: #374151;
  --about-text: #6b7280;

  /* 打赏按钮 */
  --reward-bg: #fffbeb;
  --reward-border: #b45309;
  --reward-text: #b45309;
}

/* 头部：专业布局 */
.home-header {
  display: flex;
  flex-direction: column;
}

/* 第一行：模式切换（左） + 胶囊占位（右） - 与胶囊同行 */
/* 第一行：右上角工具区 */
.header-top-row {
  display: flex;
  justify-content: space-between; /* 使得左侧占位和右侧工具分开 */
  align-items: center;
  height: 44px;
  padding: 0 8rpx;
}

.header-placeholder-left { width: 32rpx; } /* 左侧稍微占位 */

.header-right-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-placeholder {
  width: 88px; /* 胶囊占位，胶囊本身宽度约 87px，左右各有些许margin */
  height: 32px;
}

/* 模式切换：极简无背景设计 */
.theme-toggle {
  width: 60rpx;
  height: 60rpx;
  font-size: 36rpx;
  /* 移除边框和背景 */
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.8;
}

.theme-toggle:active { opacity: 0.5; transform: scale(0.9); }

/* 第二行：标题居中 - 增加间距 */
/* 第二行：标题居中 - 醒目大标题 */
/* 第二行：标题居中 - 醒目大标题 */
/* 第二行：标题居中 - 醒目大标题 */
/* 第二行：标题居中 - 醒目大标题 */
.title-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 32rpx; /* 减少上下间距 */
  margin-top: 80rpx; /* 再次增加：让红框起始位置更低 */
  position: relative; /* 为绝对定位按钮提供锚点 */
}

/* 绝对定位的低调模式切换 */
.theme-toggle-abs {
  position: absolute;
  right: 16rpx; /* 靠右 */
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  opacity: 0.4; /* 低调 */
  padding: 20rpx; /* 增加点击区域 */
}
.theme-toggle-abs:active { opacity: 0.8; }

.app-name {
  font-size: 56rpx; /* 放大标题 */
  font-weight: 800;
  letter-spacing: 4rpx;
  text-shadow: var(--title-shadow);
}

.app-sub {
  font-size: 20rpx; /* 放大副标题 */
  color: var(--primary);
  letter-spacing: 12rpx;
  font-weight: bold;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 内容区域：合理间距 */
/* 内容区域：恢复flex:1 并增加顶部内边距实现视觉下沉 */
.content-wrapper {
  flex: 1; /* 恢复撑开 */
  display: flex;
  flex-direction: column;
  padding-top: 60rpx; /* 关键：增加顶部间距，让功能列表下沉，重心更稳 */
}

/* 菜单列表：舒适间距 - 视觉拉伸 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 关键：加大间距，自然通过拉伸高度来靠近底部，消除割裂感 */
  width: 100%;
}

.menu-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 0;
  display: flex;
  align-items: stretch;
  border: 1px solid var(--border);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.menu-card:active { transform: scale(0.98); }
.card-bar { width: 10rpx; }

.card-content {
  flex: 1;
  padding: 24rpx 20rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.card-icon { font-size: 32rpx; }
.card-title { font-size: 30rpx; font-weight: bold; letter-spacing: 1rpx; }
.card-desc { font-size: 22rpx; color: var(--text-sub); opacity: 0.7; font-weight: 300; }
.card-arrow { width: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--text-sub); opacity: 0.3; }

/* 底部区域：沉底布局 */
.footer-area {
  margin-top: auto; /* 关键：恢复沉底，确保在屏幕最下方 */
  padding-top: 80rpx; /* 大幅增加顶部间距，让功能行下移，远离列表 */
  padding-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx; /* 减小间距，让功能行紧贴版权说明 */
}

.footer-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  width: 100%;
}

.footer-btn {
  background: transparent;
  border: none;
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  opacity: 0.6;
}

.footer-btn:active { opacity: 1; }
.footer-btn text { font-size: 24rpx; color: var(--text-sub); font-weight: 500; }
.ft-icon { font-size: 26rpx; }
.ft-divider { width: 1px; height: 20rpx; background: var(--text-sub); opacity: 0.2; }
.btn-reset::after { border: none; }

/* 版权 */
.copyright-box {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx; opacity: 0.3;
}
.copyright { font-size: 20rpx; font-weight: bold; font-family: "DIN Alternate", sans-serif; }
.slogan { font-size: 18rpx; font-style: italic; font-family: serif; }

/* 弹窗样式 */
.modal-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.8); backdrop-filter: blur(5px);
  z-index: 999; display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
.modal-mask.show { opacity: 1; pointer-events: auto; }
.modal-card {
  width: 82%; background: var(--card); border-radius: 32rpx; padding: 50rpx 40rpx;
  text-align: center; box-shadow: var(--modal-shadow); border: 1px solid var(--border);
}

.mc-header { display: flex; flex-direction: column; align-items: center; margin-bottom: 30rpx; }
.mc-icon-badge {
  font-size: 64rpx; margin-bottom: 20rpx; width: 100rpx; height: 100rpx;
  background: var(--input-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center;
}
.mc-title { font-size: 38rpx; font-weight: 900; }
.mc-desc { font-size: 28rpx; color: var(--text-sub); line-height: 1.6; white-space: pre-wrap; }

/* 登录框 */
.login-input-wrapper { margin-top: 40rpx; }
.login-inp-pro {
  height: 96rpx; background: var(--input-bg); border-radius: 16rpx;
  color: var(--text); font-size: 40rpx; text-align: center; letter-spacing: 12rpx; font-weight: bold;
}
.hint-text { margin-top: 24rpx; font-size: 22rpx; color: var(--text-sub); opacity: 0.6; }

/* =============================================
   ★★★ 弹窗样式（完整修复版） ★★★
   包含：Logo修复 + 间距动态适配 + 左右边距修复
============================================= */

/* 1. 弹窗容器 */
.about-content {
  display: flex; flex-direction: column; align-items: center;
  /* 左右32rpx保证文字不换行，底部10rpx拉近关闭按钮 */
  padding: 20rpx 32rpx 10rpx;
}

/* 2. 头部区域 (找回消失的Logo) */
.about-header-group {
  display: flex; flex-direction: column; align-items: center;
  /* 头部和下方文字的距离，保持适中 */
  margin-bottom: 0;
}

/* ★★★ Logo 样式 (之前丢失的部分) ★★★ */
.about-avatar {
  width: 100rpx; height: 100rpx;
  background: #1f2937; /* 深色背景 */
  border-radius: 24rpx;
  color: #fff; font-size: 40rpx; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20rpx;
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
}

.about-name {
  font-size: 38rpx; font-weight: 900; color: var(--about-title);
  letter-spacing: 2rpx;
}

/* 3. 正文区域 (动态间距逻辑) */
.about-desc-group {
  width: 100%;
  /* 审核模式下，距离关闭按钮近一点 */
  margin-bottom: 20rpx;
  /* 顶部稍微下移，不顶着Logo */
  margin-top: 30rpx;
}

.desc-text {
  font-size: 28rpx;
  color: var(--about-text);
  line-height: 1.7;
  text-align: justify; /* 两端对齐，美观 */
  display: block;
}

/* 段落间距 */
.desc-spacer { height: 30rpx; }

/* 4. 赞赏按钮 (自带顶部间距) */
.btn-reward-gold {
  /* 关键：按钮出现时，自己把上面撑开；按钮没了，这间距也没了 */
  margin-top: 40rpx;

  width: 80%;
  height: 88rpx;

  background: rgba(255, 255, 255, 0.05);
  border: 1px solid #b45309;
  color: #d97706;
  border-radius: 44rpx;

  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  font-size: 28rpx; font-weight: bold; letter-spacing: 1rpx;
  transition: all 0.2s;
}

.btn-reward-gold:active {
  background: rgba(180, 83, 9, 0.15);
  transform: scale(0.98);
}

.btn-icon { font-size: 34rpx; }

/* 5. 底部提示小字 */
.qr-hint {
  margin-top: 12rpx;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  opacity: 0.6;
  letter-spacing: 1rpx;
}

/* 底部操作 */
.mc-footer { display: flex; gap: 24rpx; margin-top: 20rpx; }
.btn-pro { flex: 1; font-size: 30rpx; font-weight: bold; height: 88rpx; line-height: 88rpx; border-radius: 20rpx; }
.btn-cancel { background: transparent; color: var(--text-sub); border: 1px solid var(--border); }
.btn-confirm { background: var(--primary); color: #fff; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1); }

/* 底部版权：腾讯风低调灰 */
.copyright-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  /* 距离上方内容远一点，距离底部留点空隙 */
  margin-top: 60rpx;
  padding-bottom: 30rpx;

  /* ★关键：透明度调低，让它看起来灰灰的，很高级 */
  opacity: 0.25;
}

.copyright-text {
  font-size: 18rpx; /* 字号极小，像合同条款一样 */
  font-family: Arial, Helvetica, sans-serif; /* 用西文字体，数字和英文更好看 */
  color: var(--text-sub); /* 跟随主题灰色 */
  letter-spacing: 1rpx;
}