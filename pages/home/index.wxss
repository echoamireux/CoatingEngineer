/* ============================================================
   首页样式
   主题变量已移至 styles/theme.wxss
   ============================================================ */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding: 0 30rpx;
  box-sizing: border-box;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
}

/* 头部：标准间距，不需要计算刘海 */
.home-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 30rpx; 
  padding-bottom: 20rpx;
}

.header-placeholder, .theme-toggle { width: 72rpx; height: 72rpx; }
.theme-toggle {
  font-size: 36rpx;
  background: var(--card);
  border-radius: 50%;
  border: 1px solid var(--border);
  text-align: center;
  line-height: 72rpx;
}

.title-box { display: flex; flex-direction: column; align-items: center; }
.app-name {
  font-size: 50rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-shadow: var(--title-shadow);
}
.app-sub {
  font-size: 18rpx;
  color: var(--primary); 
  letter-spacing: 10rpx;
  font-weight: bold;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 内容区域 */
.content-wrapper {
  flex: 1;
  display: flex; flex-direction: column;
  padding-top: 80rpx;
}

.menu-list { display: flex; flex-direction: column; gap: 32rpx; width: 100%; }
.menu-card {
  background: var(--card); border-radius: 28rpx; padding: 0;
  display: flex; align-items: stretch; border: 1px solid var(--border);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.02);
  position: relative; overflow: hidden;
  transition: transform 0.2s ease;
}
.menu-card:active { transform: scale(0.98); }
.card-bar { width: 12rpx; }
.card-content { flex: 1; padding: 32rpx 24rpx 32rpx 36rpx; display: flex; flex-direction: column; justify-content: center; }
.card-main { display: flex; align-items: center; gap: 20rpx; margin-bottom: 8rpx; }
.card-icon { font-size: 38rpx; }
.card-title { font-size: 32rpx; font-weight: bold; letter-spacing: 1rpx; }
.card-desc { font-size: 24rpx; color: var(--text-sub); opacity: 0.7; font-weight: 300; }
.card-arrow { width: 90rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: var(--text-sub); opacity: 0.3; }

/* 底部区域 */
.footer-area {
  margin-top: auto;
  padding-top: 60rpx;
  padding-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}
.footer-links {
  display: flex; align-items: center; justify-content: center;
  gap: 30rpx; width: 100%;
}
.footer-btn {
  background: transparent; border: none; padding: 10rpx 20rpx;
  display: flex; align-items: center; gap: 10rpx; opacity: 0.6;
}
.footer-btn:active { opacity: 1; }
.footer-btn text { font-size: 26rpx; color: var(--text-sub); font-weight: 500; }
.ft-icon { font-size: 30rpx; }
.ft-divider { width: 1px; height: 24rpx; background: var(--text-sub); opacity: 0.2; }
.btn-reset::after { border: none; }

/* 版权 */
.copyright-box {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx; opacity: 0.3;
}
.copyright { font-size: 20rpx; font-weight: bold; font-family: "DIN Alternate", sans-serif; }
.slogan { font-size: 18rpx; font-style: italic; font-family: serif; }

/* 弹窗样式 */
.modal-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.8); backdrop-filter: blur(5px);
  z-index: 999; display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
.modal-mask.show { opacity: 1; pointer-events: auto; }
.modal-card {
  width: 82%; background: var(--card); border-radius: 32rpx; padding: 50rpx 40rpx;
  text-align: center; box-shadow: var(--modal-shadow); border: 1px solid var(--border);
}

.mc-header { display: flex; flex-direction: column; align-items: center; margin-bottom: 30rpx; }
.mc-icon-badge {
  font-size: 64rpx; margin-bottom: 20rpx; width: 100rpx; height: 100rpx;
  background: var(--input-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center;
}
.mc-title { font-size: 38rpx; font-weight: 900; }
.mc-desc { font-size: 28rpx; color: var(--text-sub); line-height: 1.6; white-space: pre-wrap; }

/* 登录框 */
.login-input-wrapper { margin-top: 40rpx; }
.login-inp-pro {
  height: 96rpx; background: var(--input-bg); border-radius: 16rpx;
  color: var(--text); font-size: 40rpx; text-align: center; letter-spacing: 12rpx; font-weight: bold;
}
.hint-text { margin-top: 24rpx; font-size: 22rpx; color: var(--text-sub); opacity: 0.6; }

/* =============================================
   ★★★ 弹窗样式（完整修复版） ★★★
   包含：Logo修复 + 间距动态适配 + 左右边距修复
============================================= */

/* 1. 弹窗容器 */
.about-content { 
  display: flex; flex-direction: column; align-items: center; 
  /* 左右32rpx保证文字不换行，底部10rpx拉近关闭按钮 */
  padding: 20rpx 32rpx 10rpx; 
}

/* 2. 头部区域 (找回消失的Logo) */
.about-header-group {
  display: flex; flex-direction: column; align-items: center;
  /* 头部和下方文字的距离，保持适中 */
  margin-bottom: 0; 
}

/* ★★★ Logo 样式 (之前丢失的部分) ★★★ */
.about-avatar {
  width: 100rpx; height: 100rpx;
  background: #1f2937; /* 深色背景 */
  border-radius: 24rpx;
  color: #fff; font-size: 40rpx; font-weight: 900; 
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20rpx;
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
}

.about-name { 
  font-size: 38rpx; font-weight: 900; color: var(--about-title); 
  letter-spacing: 2rpx;
}

/* 3. 正文区域 (动态间距逻辑) */
.about-desc-group { 
  width: 100%; 
  /* 审核模式下，距离关闭按钮近一点 */
  margin-bottom: 20rpx;  
  /* 顶部稍微下移，不顶着Logo */
  margin-top: 30rpx;     
}

.desc-text {
  font-size: 28rpx; 
  color: var(--about-text); 
  line-height: 1.7; 
  text-align: justify; /* 两端对齐，美观 */
  display: block;
}

/* 段落间距 */
.desc-spacer { height: 30rpx; }

/* 4. 赞赏按钮 (自带顶部间距) */
.btn-reward-gold {
  /* 关键：按钮出现时，自己把上面撑开；按钮没了，这间距也没了 */
  margin-top: 40rpx; 
  
  width: 80%;       
  height: 88rpx;    
  
  background: rgba(255, 255, 255, 0.05); 
  border: 1px solid #b45309; 
  color: #d97706;            
  border-radius: 44rpx; 
  
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  font-size: 28rpx; font-weight: bold; letter-spacing: 1rpx;
  transition: all 0.2s;
}

.btn-reward-gold:active {
  background: rgba(180, 83, 9, 0.15); 
  transform: scale(0.98);
}

.btn-icon { font-size: 34rpx; }

/* 5. 底部提示小字 */
.qr-hint { 
  margin-top: 12rpx; 
  margin-bottom: 10rpx; 
  font-size: 22rpx; 
  color: var(--text-sub); 
  opacity: 0.6; 
  letter-spacing: 1rpx;
}

/* 底部操作 */
.mc-footer { display: flex; gap: 24rpx; margin-top: 20rpx; }
.btn-pro { flex: 1; font-size: 30rpx; font-weight: bold; height: 88rpx; line-height: 88rpx; border-radius: 20rpx; }
.btn-cancel { background: transparent; color: var(--text-sub); border: 1px solid var(--border); }
.btn-confirm { background: var(--primary); color: #fff; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1); }

/* 底部版权：腾讯风低调灰 */
.copyright-box {
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center;
  
  /* 距离上方内容远一点，距离底部留点空隙 */
  margin-top: 60rpx; 
  padding-bottom: 30rpx; 
  
  /* ★关键：透明度调低，让它看起来灰灰的，很高级 */
  opacity: 0.25; 
}

.copyright-text {
  font-size: 18rpx; /* 字号极小，像合同条款一样 */
  font-family: Arial, Helvetica, sans-serif; /* 用西文字体，数字和英文更好看 */
  color: var(--text-sub); /* 跟随主题灰色 */
  letter-spacing: 1rpx; 
}