/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding: 0 30rpx;
  box-sizing: border-box;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
}

/* 主题变量 */
/* 主题变量定义 */
.page-container.dark {
  --bg: #111827;
  --card: #1f2937;
  --text: #e5e7eb;
  --text-sub: #9ca3af;
  --primary: #10b981;
  --border: #374151;
  --title-shadow: 0 4rpx 8rpx rgba(0,0,0,0.5);
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.5); 
  --input-bg: rgba(255,255,255,0.05);
  
  /* ★★★ Dark模式：关于弹窗配色 ★★★ */
  --about-text: #d1d5db;        /* 浅灰字，配深底 */
  --reward-bg: rgba(0,0,0,0.3); /* 深黑透明底 */
  --reward-border: #d4af37;     /* 香槟金边框 */
  --reward-text: #d4af37;       /* 香槟金文字 */
}

.page-container.light {
  --bg: #f3f4f6;
  --card: #ffffff;
  --text: #1f2937;
  --text-sub: #6b7280;
  --primary: #059669;
  --border: rgba(0,0,0,0.05);
  --title-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.1); 
  --input-bg: rgba(0,0,0,0.03);

  /* ★★★ Light模式：关于弹窗配色 ★★★ */
  --about-text: #4b5563;           /* 深灰字，配白底（关键！解决看不清） */
  --reward-bg: rgba(212,175,55,0.1); /* 极淡的金色底，清爽 */
  --reward-border: #b45309;        /* 深琥珀色边框，有对比度 */
  --reward-text: #b45309;          /* 深琥珀色文字 */
}

/* 头部：标准间距，不需要计算刘海 */
.home-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 30rpx; 
  padding-bottom: 20rpx;
}

.header-placeholder, .theme-toggle { width: 72rpx; height: 72rpx; }
.theme-toggle {
  font-size: 36rpx;
  background: var(--card);
  border-radius: 50%;
  border: 1px solid var(--border);
  text-align: center;
  line-height: 72rpx;
}

.title-box { display: flex; flex-direction: column; align-items: center; }
.app-name {
  font-size: 50rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-shadow: var(--title-shadow);
}
.app-sub {
  font-size: 18rpx;
  color: var(--primary); 
  letter-spacing: 10rpx;
  font-weight: bold;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 内容区域 */
.content-wrapper {
  flex: 1;
  display: flex; flex-direction: column;
  padding-top: 80rpx;
}

.menu-list { display: flex; flex-direction: column; gap: 32rpx; width: 100%; }
.menu-card {
  background: var(--card); border-radius: 28rpx; padding: 0;
  display: flex; align-items: stretch; border: 1px solid var(--border);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.02);
  position: relative; overflow: hidden;
  transition: transform 0.2s ease;
}
.menu-card:active { transform: scale(0.98); }
.card-bar { width: 12rpx; }
.card-content { flex: 1; padding: 32rpx 24rpx 32rpx 36rpx; display: flex; flex-direction: column; justify-content: center; }
.card-main { display: flex; align-items: center; gap: 20rpx; margin-bottom: 8rpx; }
.card-icon { font-size: 38rpx; }
.card-title { font-size: 32rpx; font-weight: bold; letter-spacing: 1rpx; }
.card-desc { font-size: 24rpx; color: var(--text-sub); opacity: 0.7; font-weight: 300; }
.card-arrow { width: 90rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: var(--text-sub); opacity: 0.3; }

/* 底部区域 */
.footer-area {
  margin-top: auto;
  padding-top: 60rpx;
  padding-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}
.footer-links {
  display: flex; align-items: center; justify-content: center;
  gap: 30rpx; width: 100%;
}
.footer-btn {
  background: transparent; border: none; padding: 10rpx 20rpx;
  display: flex; align-items: center; gap: 10rpx; opacity: 0.6;
}
.footer-btn:active { opacity: 1; }
.footer-btn text { font-size: 26rpx; color: var(--text-sub); font-weight: 500; }
.ft-icon { font-size: 30rpx; }
.ft-divider { width: 1px; height: 24rpx; background: var(--text-sub); opacity: 0.2; }
.btn-reset::after { border: none; }

/* 版权 */
.copyright-box {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx; opacity: 0.3;
}
.copyright { font-size: 20rpx; font-weight: bold; font-family: "DIN Alternate", sans-serif; }
.slogan { font-size: 18rpx; font-style: italic; font-family: serif; }

/* 弹窗样式 */
.modal-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.8); backdrop-filter: blur(5px);
  z-index: 999; display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
.modal-mask.show { opacity: 1; pointer-events: auto; }
.modal-card {
  width: 82%; background: var(--card); border-radius: 32rpx; padding: 50rpx 40rpx;
  text-align: center; box-shadow: var(--modal-shadow); border: 1px solid var(--border);
}

.mc-header { display: flex; flex-direction: column; align-items: center; margin-bottom: 30rpx; }
.mc-icon-badge {
  font-size: 64rpx; margin-bottom: 20rpx; width: 100rpx; height: 100rpx;
  background: var(--input-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center;
}
.mc-title { font-size: 38rpx; font-weight: 900; }
.mc-desc { font-size: 28rpx; color: var(--text-sub); line-height: 1.6; white-space: pre-wrap; }

/* 登录框 */
.login-input-wrapper { margin-top: 40rpx; }
.login-inp-pro {
  height: 96rpx; background: var(--input-bg); border-radius: 16rpx;
  color: var(--text); font-size: 40rpx; text-align: center; letter-spacing: 12rpx; font-weight: bold;
}
.hint-text { margin-top: 24rpx; font-size: 22rpx; color: var(--text-sub); opacity: 0.6; }

/* 关于作者 - 布局精修 */
.about-content { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  /* 增加左右内边距，让文字不要撑得太满，显瘦才精致 */
  padding: 0 20rpx; 
  margin-bottom: 40rpx; 
}

.about-avatar {
  width: 120rpx; height: 120rpx; 
  background: #111827; 
  border-radius: 30rpx;
  color: white; font-size: 48rpx; font-weight: 900; 
  display: flex; align-items: center; justify-content: center;
  /* 增加底部距离 */
  margin-bottom: 30rpx; 
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.2);
}

.about-name { 
  font-size: 38rpx; /* 字号加大一点 */
  font-weight: 900; 
  margin-bottom: 40rpx; /* 拉大标题和正文的距离 */
  color: var(--text);
  letter-spacing: 2rpx;
}

.about-desc {
  width: 100%;
}

.about-desc text {
  font-size: 28rpx; 
  color: var(--about-text); /* 颜色更亮一点，不要太灰 */
  line-height: 2.0; /* 增大行高，让文字更疏朗 */
  text-align: justify; /* 两端对齐，显得方正 */
  display: block;
}

/* ★★★ 赞赏按钮：黑金轻奢风格 ★★★ */
.btn-reward-simple {
  /* 增加顶部距离，让它离文字远一点 */
  margin-top: 60rpx; 
  width: 100%;
  
  /* ★★★ 关键修改：全部换成变量 ★★★ */
  background: var(--reward-bg); 
  border: 1px solid var(--reward-border); 
  color: var(--reward-text);
  
  font-size: 28rpx; 
  font-weight: bold;
  letter-spacing: 1rpx;
  border-radius: 60rpx; /* 变成全圆角的胶囊形，更现代 */
  padding: 24rpx 0;
  display: flex; align-items: center; justify-content: center;
  
  /* 加一点淡淡的金光阴影 */
  box-shadow: 0 0 15rpx rgba(212, 175, 55, 0.1);
  transition: all 0.2s;
}

/* 点击反馈：微微发亮 */
.btn-reward-simple:active { 
  background: rgba(212, 175, 55, 0.1); 
  transform: scale(0.98);
}

/* 底部提示小字 */
.qr-hint { 
  margin-top: 30rpx; 
  font-size: 22rpx; 
  color: #6b7280; 
  opacity: 0.8; 
}

/* 底部操作 */
.mc-footer { display: flex; gap: 24rpx; margin-top: 20rpx; }
.btn-pro { flex: 1; font-size: 30rpx; font-weight: bold; height: 88rpx; line-height: 88rpx; border-radius: 20rpx; }
.btn-cancel { background: transparent; color: var(--text-sub); border: 1px solid var(--border); }
.btn-confirm { background: var(--primary); color: #fff; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1); }