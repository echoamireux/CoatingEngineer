/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding: 30rpx;
  box-sizing: border-box;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
}

/* 主题变量 */
.page-container.dark {
  --bg: #111827;
  --card: #1f2937;
  --text: #e5e7eb;
  --text-sub: #9ca3af;
  --primary: #10b981;
  --border: #374151;
  --title-shadow: 0 4rpx 8rpx rgba(0,0,0,0.5);
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.4); /* 更深的弹窗阴影 */
  --input-bg: rgba(255,255,255,0.05); /* 输入框背景 */
  --primary-btn-shadow: 0 8rpx 16rpx rgba(16, 185, 129, 0.3); /* 主按钮弥散阴影 */
}
.page-container.light {
  --bg: #f3f4f6;
  --card: #ffffff;
  --text: #1f2937;
  --text-sub: #6b7280;
  --primary: #059669;
  --border: #e5e7eb;
  --title-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
  --modal-shadow: 0 24rpx 48rpx rgba(0,0,0,0.1); /* 浅色弹窗阴影 */
  --input-bg: rgba(0,0,0,0.03);
  --primary-btn-shadow: 0 8rpx 16rpx rgba(5, 150, 105, 0.25);
}

/* 头部 */
.home-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
  padding: 10rpx 0;
}

.header-placeholder, .theme-toggle {
  width: 72rpx;
  height: 72rpx;
}

.theme-toggle {
  font-size: 40rpx;
  background: var(--card);
  border-radius: 50%;
  border: 1px solid var(--border);
  text-align: center;
  line-height: 72rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

/* 标题区域 */
.title-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 10rpx;
}

.app-name {
  font-size: 56rpx; 
  font-weight: 900;
  letter-spacing: 4rpx;
  line-height: 1.2;
  text-shadow: var(--title-shadow);
  font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif;
}

.app-sub {
  font-size: 20rpx;
  color: var(--primary); 
  letter-spacing: 12rpx;
  font-weight: bold;
  opacity: 0.9;
  margin-top: 12rpx;
  text-transform: uppercase; 
  font-family: "DIN Alternate", Helvetica, sans-serif;
}

/* 内容布局 */
.content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-top: 100rpx;
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.menu-card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 0;
  display: flex;
  align-items: stretch;
  border: 1px solid var(--border);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease;
}
.menu-card:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.card-bar { width: 12rpx; }

.card-content {
  flex: 1;
  padding: 32rpx 24rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.card-icon { font-size: 38rpx; }

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  padding-left: 2rpx;
  opacity: 0.7;
  font-weight: 300;
}

.card-arrow {
  width: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-sub);
  opacity: 0.3;
}

/* 页脚 */
.footer {
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  opacity: 0.25;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  margin-top: auto;
}
.copyright { 
  font-size: 20rpx; 
  font-weight: bold; 
  font-family: "DIN Alternate", sans-serif;
  letter-spacing: 1rpx;
}
.slogan { font-size: 18rpx; font-style: italic; }

/* ★★★ 专业级弹窗样式 Pro ★★★ */
.modal-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.6); /*稍微通透一点的遮罩*/
  backdrop-filter: blur(4px); /* 增加高级的毛玻璃效果 (部分机型支持) */
  z-index: 999;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: all 0.3s ease;
}
/* 弹窗显示动画 */
.modal-mask.show { opacity: 1; pointer-events: auto; }
.modal-mask.show .modal-card { transform: translateY(0) scale(1); opacity: 1; }

.modal-card {
  width: 80%; /* 稍微宽一点 */
  background: var(--card);
  border-radius: 32rpx; /* 更大的圆角 */
  padding: 40rpx; /* 更大的内边距 */
  text-align: center;
  box-shadow: var(--modal-shadow); /* 高级阴影 */
  border: 1px solid var(--border);
  transform: translateY(20rpx) scale(0.95); /* 初始状态 */
  opacity: 0; transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); /* 弹性动画 */
}

/* 1. 弹窗头部 */
.mc-header {
  display: flex; flex-direction: column; align-items: center;
  margin-bottom: 30rpx;
}
.mc-icon-badge {
  font-size: 64rpx; margin-bottom: 20rpx;
  width: 100rpx; height: 100rpx;
  background: var(--input-bg); /* 微妙的背景底座 */
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.mc-title {
  font-size: 38rpx; font-weight: 900; color: var(--text);
  letter-spacing: 1rpx;
}

/* 2. 弹窗主体 */
.mc-body { margin-bottom: 50rpx; }
.mc-desc {
  font-size: 28rpx; color: var(--text-sub);
  line-height: 1.6;
  white-space: pre-wrap;
  display: block;
  opacity: 0.9;
}

/* 专业输入框包裹层 */
.login-input-wrapper {
  margin-top: 40rpx;
  padding: 0 10rpx;
}
/* 专业输入框样式 */
.login-inp-pro {
  height: 96rpx;
  background: var(--input-bg);
  border: 1px solid transparent; /* 默认无边框 */
  border-radius: 16rpx;
  color: var(--text);
  font-size: 40rpx; /* 更大的字号 */
  text-align: center;
  letter-spacing: 12rpx; /* 极大的字间距，像密码格 */
  font-weight: bold;
  font-family: "DIN Alternate", monospace;
  transition: all 0.2s;
}
/* 输入框聚焦态（模拟）- 实际上小程序 input focus 样式有限，这里做个基础 */
.login-inp-pro:focus {
  border-color: var(--primary);
  background: var(--bg);
}
.ph-style-pro {
  color: var(--text-sub);
  font-size: 28rpx;
  font-weight: normal;
  letter-spacing: 2rpx;
  opacity: 0.5;
}

/* 3. 弹窗底部按钮 */
.mc-footer { display: flex; gap: 24rpx; }
.btn-pro {
  flex: 1;
  font-size: 30rpx; font-weight: bold;
  height: 96rpx; line-height: 96rpx; /* 更高的按钮 */
  border-radius: 20rpx; /* 更圆润 */
  border: none; /* 去掉默认边框 */
  transition: all 0.2s;
}
.btn-pro:active { transform: scale(0.98); }

.btn-cancel {
  background: transparent; /* 透明背景 */
  color: var(--text-sub);
  border: 1px solid var(--border); /* 细边框 */
}
.btn-confirm {
  background: var(--primary);
  color: #fff;
  /* 核心：品牌色弥散阴影，增加立体感 */
  box-shadow: var(--primary-btn-shadow); 
}