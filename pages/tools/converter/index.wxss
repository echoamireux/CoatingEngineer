/* Converter 页面样式 - 继承全局主题变量 */
page {
  /* Converter专属变量 */
  --input: var(--card);
  --nav-bg: var(--card);
  --highlight: var(--accent);
  --nav-active: var(--accent-dim);
}

.page-container.light {
  --nav-bg: #eef2f6;
  --nav-active: #ffffff;
  --input: #ffffff;
}

.page-container {
  height: 100vh;
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  font-family: -apple-system, sans-serif;
}

/* 导航栏样式 */
.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg);
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav-row {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
  width: 100%;
}

.back-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 主布局：左右分栏 */
.main-layout {
  flex: 1;
  display: flex;
  overflow: hidden;
  margin-top: 20rpx;
}

/* 左侧侧栏 */
.sidebar {
  width: 160rpx;
  background: var(--nav-bg);
  border-right: 1px solid var(--border);
  height: 100%;
  box-sizing: border-box;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 140rpx;
  color: var(--text-sub);
  font-size: 24rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  transition: all 0.2s;
  position: relative;
}

.nav-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
  opacity: 0.7;
}

.nav-item.active {
  background: var(--nav-active);
  color: var(--accent);
  font-weight: bold;
}

.nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 6rpx;
  background: var(--accent);
  border-radius: 0 4rpx 4rpx 0;
}

/* 右侧内容区 */
.content-panel {
  flex: 1;
  padding: 30rpx;
  box-sizing: border-box;
}

.unit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}