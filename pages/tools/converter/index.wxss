/* Converter 页面样式 - 继承全局主题变量 */
page {
  /* Converter专属变量 */
  --input: var(--card);
  --nav-bg: var(--card);
  --highlight: var(--accent);
  --nav-active: var(--accent-dim);
}

.page-container.light {
  --nav-bg: #eef2f6;
  --nav-active: #ffffff;
  --input: #ffffff;
}

.page-container {
  height: 100vh;
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  font-family: -apple-system, sans-serif;
}

/* 导航栏样式 - 沉浸式设计 */
.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg); /* 沉浸式：与页面背景一致 */
  /* 移除border-bottom */
  box-sizing: border-box;
  flex-shrink: 0;
}

/* 导航栏 - 第一行 */
.nav-row {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
  width: 100%;
}

/* 工具栏 - 第二行 (紧凑/无底色) */
.toolbar-row {
  height: 32px; /* 极度紧凑 */
  display: flex;
  align-items: center;
  justify-content: flex-start; /* 左对齐 */
  padding: 0 24rpx;
  gap: 40rpx; /* 图标间较大间距 */
  background: transparent;
  margin-bottom: 4rpx;
}

/* Back Button */
.back-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-sub);
  font-weight: 300;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Tool Button - Ghost Style */
.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: auto;
  padding: 4rpx;
  background: transparent !important;
  border: none !important;
  border-radius: 8rpx;
}

.tool-hover {
  opacity: 0.6;
  transform: scale(0.95);
}

.tool-btn .icon {
  font-size: 30rpx; /* 精致小图标 */
  opacity: 0.7;
  line-height: 1;
}

/* 移除旧样式 */
/* .toolbar-row moved to nav-row integration */

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1px;
  color: var(--text);
}

.actions {
  display: flex;
  gap: 20rpx;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 适配紫色主题 (Violet) - Tools 模块专属主题色 */
  background: rgba(139, 92, 246, 0.15);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  transition: all 0.2s;
}

.icon-btn:active {
  transform: scale(0.9);
  opacity: 0.8;
  background: rgba(139, 92, 246, 0.25);
}

/* 主布局：左右分栏 */
.main-layout {
  flex: 1;
  display: flex;
  overflow: hidden;
  margin-top: 20rpx;
}

/* 左侧侧栏 */
.sidebar {
  width: 160rpx;
  background: var(--nav-bg);
  border-right: 1px solid var(--border);
  height: 100%;
  box-sizing: border-box;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 140rpx;
  color: var(--text-sub);
  font-size: 24rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  transition: all 0.2s;
  position: relative;
}

.nav-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
  opacity: 0.7;
}

.nav-item.active {
  background: var(--nav-active);
  color: var(--accent);
  font-weight: bold;
}

.nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 6rpx;
  background: var(--accent);
  border-radius: 0 4rpx 4rpx 0;
}

/* 右侧内容区 */
.content-panel {
  flex: 1;
  padding: 30rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 30rpx;
  border: 1px solid var(--border);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.card-head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid var(--border);
}

.head-title {
  font-size: 28rpx;
  color: var(--highlight);
  font-weight: bold;
  border-left: 3px solid var(--highlight);
  padding-left: 12rpx;
}

.reset-link {
  font-size: 24rpx;
  color: var(--text-sub);
  text-decoration: underline;
}

/* 输入框通用 (56rpx标准) */
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.space-bottom {
  margin-bottom: 30rpx;
}

/* 拉大间距 */

.label {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 10rpx;
}

.label.highlight {
  color: var(--highlight);
}

.input-box {
  display: flex;
  align-items: center;
  background: var(--input);
  border-radius: 8rpx;
  border: 1px solid var(--border);
  height: 56rpx;
  padding: 0 20rpx;
  transition: all 0.2s;
}

.input-box.large {
  height: 80rpx;
}

.inp {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text);
  font-weight: bold;
}

.inp.center {
  text-align: center;
  font-size: 36rpx;
}

.input-box:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
}

.unit-tag {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-left: 12rpx;
}

.unit-tag.fixed-w {
  width: 90rpx;
  text-align: right;
}

.divider {
  height: 1px;
  background: var(--border);
  margin: 30rpx 0;
  border-bottom: 1px dashed var(--border);
  opacity: 0.5;
}

.convert-row {
  display: flex;
  align-items: center;
  flex-direction: column;
}

/* 垂直布局修正 */
.c-col {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.unit-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  text-align: right;
}

.icon-wrap {
  font-size: 32rpx;
  color: var(--text-sub);
  margin: 10rpx 0;
  transform: rotate(90deg);
  display: none;
}

/* 侧栏模式下隐藏交换标或改样式 */

/* 列表行样式 */
.unit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.unit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.u-meta {
  display: flex;
  align-items: center;
  width: 180rpx;
}

.u-name {
  font-size: 26rpx;
  color: var(--text);
  font-weight: normal;
}

.si-tag {
  font-size: 18rpx;
  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: 6rpx;
  padding: 0 6rpx;
  margin-left: 10rpx;
  opacity: 0.8;
}

.right-align {
  flex: 1;
}