/* === V25 午夜蓝主题变量 === */
page {
  --bg: #10141e; --card: #1f2937; --text: #f3f4f6; --text-sub: #9ca3af;
  --accent: #3b82f6; --highlight: #38bdf8; --border: #374151; --input: #111827;
  --nav-bg: #161e2a; /* 侧栏背景 */
  --nav-active: rgba(59,130,246,0.15);
}
.page-container.light {
  --bg: #f2f4f7; --card: #ffffff; --text: #333; --text-sub: #666; 
  --accent: #1989fa; --highlight: #1989fa; --input: #f7f8fa; --border: #e0e0e0;
  --nav-bg: #eef2f6; --nav-active: #ffffff;
}

.page-container {
  height: 100vh; background: var(--bg); color: var(--text);
  display: flex; flex-direction: column; overflow: hidden;
  font-family: -apple-system, sans-serif;
}

/* 顶部 Header */
.nav-bar {
  height: 88rpx; display: flex; justify-content: space-between; align-items: center;
  padding: 0 24rpx; background: var(--nav-bg); border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.nav-title { font-size: 32rpx; font-weight: 800; letter-spacing: 1px; }
.icon-btn { background: var(--card); border: 1px solid var(--border); padding: 6rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }

/* 主布局：左右分栏 */
.main-layout { flex: 1; display: flex; overflow: hidden; }

/* 左侧侧栏 */
.sidebar {
  width: 160rpx; background: var(--nav-bg); border-right: 1px solid var(--border);
  height: 100%; box-sizing: border-box;
}
.nav-item {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  height: 140rpx; color: var(--text-sub); font-size: 24rpx;
  border-bottom: 1px solid rgba(255,255,255,0.03); transition: all 0.2s;
  position: relative;
}
.nav-icon { font-size: 40rpx; margin-bottom: 8rpx; opacity: 0.7; }
.nav-item.active {
  background: var(--nav-active); color: var(--accent); font-weight: bold;
}
.nav-item.active::before {
  content: ''; position: absolute; left: 0; top: 20rpx; bottom: 20rpx; width: 6rpx;
  background: var(--accent); border-radius: 0 4rpx 4rpx 0;
}

/* 右侧内容区 */
.content-panel { flex: 1; padding: 30rpx; box-sizing: border-box; }

.card { background: var(--card); border-radius: 16rpx; padding: 30rpx; border: 1px solid var(--border); box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2); }
.card-head-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; padding-bottom: 16rpx; border-bottom: 1px solid var(--border); }
.head-title { font-size: 28rpx; color: var(--highlight); font-weight: bold; border-left: 3px solid var(--highlight); padding-left: 12rpx; }
.reset-link { font-size: 24rpx; color: var(--text-sub); text-decoration: underline; }

/* 输入框通用 (56rpx标准) */
.field { display: flex; flex-direction: column; margin-bottom: 24rpx; }
.space-bottom { margin-bottom: 30rpx; } /* 拉大间距 */

.label { font-size: 24rpx; color: var(--text-sub); margin-bottom: 10rpx; }
.label.highlight { color: var(--highlight); }

.input-box {
  display: flex; align-items: center; background: var(--input);
  border-radius: 8rpx; border: 1px solid var(--border);
  height: 56rpx; padding: 0 20rpx; transition: all 0.2s;
}
.input-box.large { height: 80rpx; }

.inp { flex: 1; text-align: right; font-size: 28rpx; color: var(--text); font-weight: bold; }
.inp.center { text-align: center; font-size: 36rpx; }
.input-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(59,130,246,0.2); }
.unit-tag { font-size: 24rpx; color: var(--text-sub); margin-left: 12rpx; }
.unit-tag.fixed-w { width: 90rpx; text-align: right; }

.divider { height: 1px; background: var(--border); margin: 30rpx 0; border-bottom: 1px dashed var(--border); opacity: 0.5; }
.convert-row { display: flex; align-items: center; flex-direction: column; } /* 垂直布局修正 */
.c-col { width: 100%; display: flex; flex-direction: column; }
.unit-sub { font-size: 22rpx; color: var(--text-sub); margin-top: 6rpx; text-align: right; }
.icon-wrap { font-size: 32rpx; color: var(--text-sub); margin: 10rpx 0; transform: rotate(90deg); display: none; } /* 侧栏模式下隐藏交换标或改样式 */

/* 列表行样式 */
.unit-list { display: flex; flex-direction: column; gap: 20rpx; }
.unit-row { display: flex; align-items: center; justify-content: space-between; }
.u-meta { display: flex; align-items: center; width: 180rpx; }
.u-name { font-size: 26rpx; color: var(--text); font-weight: normal; }
.si-tag {
  font-size: 18rpx; color: var(--accent); border: 1px solid var(--accent);
  border-radius: 6rpx; padding: 0 6rpx; margin-left: 10rpx; opacity: 0.8;
}
.right-align { flex: 1; }
