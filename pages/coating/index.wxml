<view class="page-container {{theme}}">

  <!-- 统一的导航栏 -->
  <view class="nav-bar">
    <view class="nav-title">涂布与卷材计算</view>
    <view class="actions">
      <view class="icon-btn" bindtap="saveCompHistory"
        wx:if="{{currentTab=='composite' && (result_diameter !== '-' || result_weight !== '-')}}">💾</view>
      <view class="icon-btn" bindtap="saveGlueHistory"
        wx:if="{{currentTab=='glue' && (result_pump_speed !== '-' || result_wet_weight !== '-')}}">💾</view>
      <view class="icon-btn" bindtap="openHistory">📜</view>
      <view class="icon-btn" bindtap="resetComposite" wx:if="{{currentTab=='composite'}}">🧹</view>
      <view class="icon-btn" bindtap="resetGlue" wx:if="{{currentTab=='glue'}}">🧹</view>
    </view>
  </view>

  <!-- Tabs 移动到导航栏下方 -->
  <view class="tabs">
    <view class="tab-item {{currentTab=='composite' ? 'active' : ''}}" bindtap="switchTab" data-tab="composite">复合卷材
    </view>
    <view class="tab-item {{currentTab=='glue' ? 'active' : ''}}" bindtap="switchTab" data-tab="glue">涂布工艺</view>
  </view>

  <view class="panel" wx:if="{{currentTab=='composite'}}">
    <view class="card">
      <view class="section-title">基础参数输入</view>

      <view class="input-row">
        <view class="label-row">
          <text class="label">管芯内径 i (mm)</text>
          <view class="tags">
            <view class="tag" bindtap="setCoreSize" data-size="76.2">3英寸</view>
            <view class="tag" bindtap="setCoreSize" data-size="152.4">6英寸</view>
            <view class="tag" bindtap="setCoreSize" data-size="0">清空</view>
          </view>
        </view>
        <input class="input {{errors.comp_i?'error-border':''}}" type="digit" bindinput="bindInput" data-field="comp_i"
          value="{{comp_i}}" placeholder="请输入" placeholder-class="input-placeholder" />
      </view>

      <view class="flex-row">
        <view class="input-row flex-item">
          <text class="label">管芯壁厚 c (mm)</text>
          <input class="input {{errors.comp_c?'error-border':''}}" type="digit" bindinput="bindInput"
            data-field="comp_c" value="{{comp_c}}" placeholder="请输入" placeholder-class="input-placeholder" />
        </view>
        <view class="input-row flex-item">
          <text class="label">卷材长度 L (m)</text>
          <input class="input {{errors.comp_L?'error-border':''}}" type="digit" bindinput="bindInput"
            data-field="comp_L" value="{{comp_L}}" placeholder="请输入" placeholder-class="input-placeholder" />
        </view>
      </view>

      <view class="divider"></view>

      <view class="section-title" style="justify-content: space-between;">
        <text>材料层结构 ({{layers.length}}层)</text>
        <text class="btn-text-plain" bindtap="addLayer">+ 添加层</text>
      </view>

      <block wx:for="{{layers}}" wx:key="id">
        <view class="layer-item">
          <view class="layer-header">
            <text style="color:var(--text-sub); font-size:26rpx; font-weight:bold;">材料层 #{{index+1}}</text>
            <text style="color:#ef4444; font-size:26rpx;" bindtap="removeLayer" data-index="{{index}}"
              wx:if="{{index > 0}}">删除</text>
          </view>
          <view class="grid-3">
            <view class="input-group">
              <text class="label">幅宽 W(mm)</text>
              <input class="input {{item.err_w?'error-border':''}}" type="digit" bindinput="bindLayerInput"
                data-index="{{index}}" data-field="width" value="{{item.width}}" placeholder="请输入"
                placeholder-class="input-placeholder" />
            </view>
            <view class="input-group">
              <text class="label">厚度 t(µm)</text>
              <input class="input {{item.err_t?'error-border':''}}" type="digit" bindinput="bindLayerInput"
                data-index="{{index}}" data-field="thickness" value="{{item.thickness}}" placeholder="请输入"
                placeholder-class="input-placeholder" />
            </view>
            <view class="input-group">
              <text class="label">密度 ρ(g/cm³)</text>
              <input class="input {{item.err_d?'error-border':''}}" type="digit" bindinput="bindLayerInput"
                data-index="{{index}}" data-field="density" value="{{item.density}}" placeholder="请输入"
                placeholder-class="input-placeholder" />
            </view>
          </view>
        </view>
      </block>

      <view class="btn-grid">
        <view class="btn-wrapper">
          <button class="btn btn-secondary" bindtap="calcCompDiameter">计算卷径 (D)</button>
          <text class="hint-text">需要: i, c, L, t</text>
        </view>
        <view class="btn-wrapper">
          <button class="btn btn-secondary" bindtap="calcCompWeight">计算重量 (M)</button>
          <text class="hint-text">需要: L, W, t, ρ</text>
        </view>
        <view class="btn-wrapper full-width">
          <button class="btn btn-primary" bindtap="calculateComposite">一键计算全部</button>
          <text class="hint-text">需要: 所有参数</text>
        </view>

      </view>
    </view>

    <view class="card">
      <view class="section-title">计算结果</view>

      <view class="result-row">
        <view class="result-header">
          <view class="label-group">
            <text class="result-label">收卷卷径 D</text>
            <text class="result-unit-sub">(mm)</text>
          </view>
          <view class="formula-box" catchtap="showFormula" data-target="diameter">公式</view>
        </view>
        <text class="result-val">{{result_diameter}}</text>
      </view>
      <view class="result-row">
        <view class="result-header">
          <view class="label-group">
            <text class="result-label">材料总重 M</text>
            <text class="result-unit-sub">(kg)</text>
          </view>
          <view class="formula-box" catchtap="showFormula" data-target="c_weight">公式</view>
        </view>
        <text class="result-val">{{result_weight}}</text>
      </view>
    </view>
  </view>

  <view class="panel" wx:if="{{currentTab=='glue'}}">
    <view class="card">
      <view class="section-title">计算基准</view>
      <view class="radio-group">
        <view class="radio-item {{glueCalcType=='thickness' ? 'checked' : ''}}" bindtap="switchGlueType"
          data-type="thickness">干厚 (t_dry)</view>
        <view class="radio-item {{glueCalcType=='weight' ? 'checked' : ''}}" bindtap="switchGlueType"
          data-type="weight">干涂量 (m_dry)</view>
      </view>

      <view class="divider"></view>
      <view class="section-title">核心参数</view>

      <block wx:if="{{glueCalcType=='thickness'}}">
        <view class="flex-row">
          <view class="input-row flex-item">
            <text class="label">干厚 t_dry (µm)</text>
            <input class="input {{errors.glue_t_dry?'error-border':''}}" type="digit" bindinput="bindInput"
              data-field="glue_t_dry" value="{{glue_t_dry}}" placeholder="请输入" placeholder-class="input-placeholder" />
          </view>
          <view class="input-row flex-item">
            <text class="label">干胶密度 <text class="sym">ρ_dry</text> (g/cm³)</text>
            <input class="input {{errors.glue_rho_dry?'error-border':''}}" type="digit" bindinput="bindInput"
              data-field="glue_rho_dry" value="{{glue_rho_dry}}" placeholder="请输入"
              placeholder-class="input-placeholder" />
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="input-row">
          <text class="label">干涂量 m_dry (g/m²)</text>
          <input class="input {{errors.glue_m_dry?'error-border':''}}" type="digit" bindinput="bindInput"
            data-field="glue_m_dry" value="{{glue_m_dry}}" placeholder="请输入" placeholder-class="input-placeholder" />
        </view>
      </block>

      <view class="divider"></view>
      <view class="section-title">胶液与工艺参数</view>

      <view class="grid-2">
        <view class="input-group">
          <text class="label">固含量 S (%)</text>
          <input class="input {{errors.glue_S?'error-border':''}}" type="digit" bindinput="bindInput"
            data-field="glue_S" value="{{glue_S}}" placeholder="请输入" placeholder-class="input-placeholder" />
        </view>
        <view class="input-group">
          <text class="label">湿胶密度 ρ_wet (g/cm³)</text>
          <input class="input {{errors.glue_rho_wet?'error-border':''}}" type="digit" bindinput="bindInput"
            data-field="glue_rho_wet" value="{{glue_rho_wet}}" placeholder="请输入"
            placeholder-class="input-placeholder" />
        </view>
      </view>
      <view class="grid-2" style="margin-top:20rpx">
        <view class="input-group">
          <text class="label">涂布幅宽 W (mm)</text>
          <input class="input {{errors.glue_W?'error-border':''}}" type="digit" bindinput="bindInput"
            data-field="glue_W" value="{{glue_W}}" placeholder="请输入" placeholder-class="input-placeholder" />
        </view>
        <view class="input-group">
          <text class="label">生产线速 v (m/min)</text>
          <input class="input {{errors.glue_v?'error-border':''}}" type="digit" bindinput="bindInput"
            data-field="glue_v" value="{{glue_v}}" placeholder="请输入" placeholder-class="input-placeholder" />
        </view>
      </view>
      <view class="grid-2" style="margin-top:20rpx">
        <view class="input-group">
          <text class="label">泵排量 Dp (cc/rev)</text>
          <input class="input {{errors.glue_Dp?'error-border':''}}" type="digit" bindinput="bindInput"
            data-field="glue_Dp" value="{{glue_Dp}}" placeholder="请输入" placeholder-class="input-placeholder" />
        </view>
        <view class="input-group">
          <text class="label">涂布长度 L (m)</text>
          <input class="input {{errors.glue_L?'error-border':''}}" type="digit" bindinput="bindInput"
            data-field="glue_L" value="{{glue_L}}" placeholder="请输入" placeholder-class="input-placeholder" />
        </view>
      </view>

      <view class="btn-grid">
        <view class="btn-wrapper">
          <button class="btn btn-secondary" bindtap="calcGluePump">计算泵速 (N)</button>
          <text class="hint-text">需要: 核心参数, S, ρ_wet, W, v, Dp</text>
        </view>
        <view class="btn-wrapper">
          <button class="btn btn-secondary" bindtap="calcGlueWetWeight">计算湿重 (Mw)</button>
          <text class="hint-text">需要: 核心参数, S, W, L</text>
        </view>
        <view class="btn-wrapper full-width">
          <button class="btn btn-primary" bindtap="calculateGlue">一键计算全部</button>
          <text class="hint-text">需要: 所有参数</text>
        </view>

      </view>
    </view>

    <view class="card">
      <view class="section-title">计算结果</view>

      <view class="result-row">
        <view class="result-header">
          <view class="label-group">
            <text class="result-label">供液泵转速 N</text>
            <text class="result-unit-sub">(rpm)</text>
          </view>
          <view class="formula-box" catchtap="showFormula" data-target="pump">公式</view>
        </view>
        <text class="result-val">{{result_pump_speed}}</text>
      </view>

      <view class="result-row">
        <view class="result-header">
          <view class="label-group">
            <text class="result-label">所需湿胶重量 Mw</text>
            <text class="result-unit-sub">(kg)</text>
          </view>
          <view class="formula-box" catchtap="showFormula" data-target="weight">公式</view>
        </view>
        <text class="result-val">{{result_wet_weight}}</text>
      </view>
    </view>
  </view>


  <view class="modal-mask" wx:if="{{showHistoryModal}}" bindtap="closeHistory">
    <view class="modal-card history-card" catchtap="true">
      <view class="mc-head">{{currentTab=='composite'?'复合卷材历史':'涂布工艺历史'}}</view>
      <scroll-view scroll-y class="history-scroll">
        <block wx:if="{{currentTab=='composite'}}">
          <view class="history-item" wx:for="{{historyList}}" wx:key="ts" bindtap="loadHistoryItem"
            data-item="{{item}}">
            <view class="h-info">
              <text class="h-desc">{{item.desc}}</text>
              <text class="h-time">{{item.dateStr}}</text>
            </view>
            <view class="h-del" catchtap="deleteHistoryItem" data-ts="{{item.ts}}">删除</view>
          </view>
        </block>
        <block wx:else>
          <view class="history-item" wx:for="{{historyList}}" wx:key="ts" bindtap="loadHistoryItem"
            data-item="{{item}}">
            <view class="h-info">
              <text class="h-desc">{{item.desc}}</text>
              <text class="h-time">{{item.dateStr}}</text>
            </view>
            <view class="h-del" catchtap="deleteHistoryItem" data-ts="{{item.ts}}">删除</view>
          </view>
        </block>
        <view class="empty-hint" wx:if="{{historyList.length==0}}">暂无记录</view>
      </scroll-view>
      <view class="mc-foot">
        <button class="btn-ghost" bindtap="closeHistory">关闭</button>
      </view>
    </view>
  </view>

  <view class="formula-float-bar {{showFormulaBar?'show':''}}">
    <view class="ff-content">
      <view class="ff-text" wx:if="{{currentFormula.type=='text'}}">
        {{currentFormula.val}}
      </view>
      <view class="ff-frac-group" wx:if="{{currentFormula.type=='frac'}}">
        <view class="ff-col">
          <text class="ff-title">{{currentFormula.title}}</text>
          <view class="ff-frac">
            <text class="ff-up">{{currentFormula.up}}</text>
            <view class="ff-line"></view>
            <text class="ff-down">{{currentFormula.down}}</text>
          </view>
        </view>
      </view>
      <view class="ff-close" bindtap="closeFormulaBar">
        <view class="ff-close-icon">✕</view>
      </view>
    </view>
  </view>

</view>