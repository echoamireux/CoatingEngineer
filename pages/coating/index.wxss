  align-items: center;
}

.legend-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 8rpx;
  border-top: 1px dashed var(--border);
}

.legend-inline text {
  font-size: 20rpx;
  color: var(--text-sub);
}

.legend-inline .b {
  font-weight: bold;
  color: var(--accent);
  margin-right: 4rpx;
}

.frac.small .n,
.frac.small .d {
  font-size: 22rpx;
  padding: 0 4rpx;
}

/* 核心输入框优化 */
.input-row-split {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-half {
  flex: 1;
}

.quick-btn-group {
  display: flex;
  gap: 12rpx;
}

.q-btn {
  background: var(--accent-dim);
  color: var(--accent);
  border: 1px solid var(--border);
  font-size: 26rpx;
  font-family: monospace;
  font-weight: bold;
  height: 64rpx;
  /* 与输入框等高 */
  padding: 0 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.q-btn.icon {
  padding: 0 20rpx;
  font-size: 28rpx;
}

.q-btn:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.convert-formula {
  text-align: center;
  font-family: "Courier New", monospace;
  font-size: 26rpx;
  color: var(--accent);
  padding: 12rpx 16rpx;
  background: rgba(99, 102, 241, 0.05);
  /* 更淡的背景 */
  border: 1px solid rgba(99, 102, 241, 0.1);
  /* 细微边框 */
  border-radius: 8rpx;
  margin: 16rpx 0 20rpx 0;
  width: fit-content;
  margin-left: auto;
  margin-right: auto;
}

.convert-inputs {
  margin-bottom: 16rpx;
}

.input-row-inline {
  display: flex;
  gap: 16rpx;
}

.input-col {
  flex: 1;
}

.input-col .label {
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.input-col .input {
  height: 60rpx;
  font-size: 26rpx;
}

.convert-result {
  text-align: center;
  padding: 24rpx;
  /* Increased padding */
  background: rgba(245, 158, 11, 0.1);
  /* Amber Tint */
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  border: 1px solid rgba(245, 158, 11, 0.2);
}

.result-label {
  font-size: 24rpx;
  color: var(--text-sub);
  display: block;
  margin-bottom: 8rpx;
}

.result-value {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--accent);
  /* Theme Amber */
  font-family: "DIN Alternate", monospace;
}

.convert-card .mc-foot {
  display: flex;
  gap: 20rpx;
}

.convert-card .btn-primary {
  flex: 1;
  background: linear-gradient(135deg, var(--accent) 0%, #d97706 100%);
  /* Premium Gradient */
  color: #fff;
  border: none;
  border-radius: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
  /* Soft Shadow */
  transition: all 0.2s;
}

.convert-card .btn-primary:active {
  opacity: 0.9;
  transform: translateY(1px);
}

/* 结果网格布局 */
.result-card {
  padding: 16rpx;
  background: linear-gradient(135deg, var(--card-bg) 0%, rgba(37, 99, 235, 0.03) 100%);
}

.result-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.result-box {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.1) 0%, rgba(37, 99, 235, 0.05) 100%);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 1px solid rgba(37, 99, 235, 0.2);
  position: relative;
  overflow: hidden;
}

.result-box::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
}

.result-box .result-label {
  font-size: 20rpx;
  color: var(--text-sub);
  display: block;
  margin-bottom: 8rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.result-value-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx;
}

.result-box .result-val {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--accent);
  font-family: "DIN Alternate", sans-serif;
  text-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.3);
}

.result-unit {
  font-size: 20rpx;
  color: var(--text-sub);
  font-weight: 500;
}