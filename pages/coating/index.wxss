page {
  --bg-base: #0f172a;
  --card-bg: #1e293b;
  --text-main: #f1f5f9;
  --text-sub: #94a3b8;
  --border: #334155;
  --input-bg: #020617;
  --success: #10b981;
  --ph-color: rgba(255, 255, 255, 0.1);

  font-family: "DIN Alternate", "Roboto", Helvetica, sans-serif;
  box-sizing: border-box;
}

.page-container.light {
  /* Inherit global light theme values, only override specific Coating needs if any */
  --bg-base: #f1f5f9;
  --card-bg: #ffffff;
  --text-main: #0f172a;
  --text-sub: #64748b;
  --border: #e2e8f0;
  --input-bg: #f8fafc;
  --ph-color: rgba(0, 0, 0, 0.1);
  /* Do NOT override --primary or --accent here, let app.wxss handle it */
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
  color: var(--text-main);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* 统一的导航栏样式 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: 0 -1px 0 var(--card-bg);
}

.nav-title {
  font-size: 38rpx;
  font-weight: bold;
  letter-spacing: 1px;
  color: var(--text-main);
}

.actions {
  display: flex;
  gap: 20rpx;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-dim);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  font-size: 28rpx;
  transition: all 0.2s;
}

.icon-btn:active {
  transform: scale(0.9);
  opacity: 0.8;
}

/* Tabs */
.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.05);
  /* Lighter than input-bg */
  padding: 8rpx;
  border-radius: 20rpx;
  margin: 20rpx 30rpx;
  border: none;
  transition: all 0.3s;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  color: var(--text-sub);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 14rpx;
  transition: all 0.3s;
}

.tab-item.active {
  color: var(--primary);
  background-color: var(--card-bg);
  /* Lifted effect */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  font-weight: 800;
  border: none;
}

/* ... Panel ... */

/* Buttons */
.btn-primary {
  background: var(--btn-gradient);
  color: white;
  box-shadow: 0 4rpx 12rpx var(--accent-dim);
  border-radius: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  opacity: 1;
  /* Ensure no transparency */
}

