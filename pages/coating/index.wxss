}

.hi-v {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: bold;
  text-align: right;
  font-family: "DIN Alternate", sans-serif;
}

.empty-hint {
  text-align: center;
  color: var(--text-sub);
  padding: 60rpx 0;
  font-size: 26rpx;
