/* ============================================================
   全局样式引入
   1. theme.wxss - 主题变量（暗黑/明亮模式）
   2. common.wxss - 公共样式类
   ============================================================ */
@import "styles/theme.wxss";
@import "styles/common.wxss";

/* ============================================================
   应用级样式
   ============================================================ */
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 
